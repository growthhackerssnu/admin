# === Database (Supabase Postgres, via Prisma) ===
# Supabase Dashboard -> Project Settings -> Database
# Transaction pooler (port 6543) -- used by the app at runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) -- used only by `prisma migrate`
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# === Supabase Auth ===
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never expose to the frontend or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=""

# === Notion (알럼나이 명단 동기화) ===
# notion.so/my-integrations 에서 internal integration 생성 후 토큰 발급,
# 명단 데이터베이스를 Share 메뉴에서 그 integration에 공유해야 함.
NOTION_API_KEY=""
NOTION_ALUMNI_DATABASE_ID=""
# 컬럼명이 기본값(기수/이름/이메일)과 다르면 지정
# NOTION_COHORT_PROPERTY="기수"
# NOTION_NAME_PROPERTY="이름"
# NOTION_EMAIL_PROPERTY="이메일"

# === OpenAI ===
OPENAI_API_KEY="sk-..."

# === Inngest ===
# 로컬 개발(inngest-cli dev)에서는 비워둬도 됨. 배포 시 Inngest 대시보드에서 발급.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
