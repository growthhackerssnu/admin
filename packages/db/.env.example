# === Database (Supabase Postgres) ===
# 이 패키지는 DB 구조의 유일한 원본이다. 마이그레이션은 여기서만 만들고 적용한다.
# 규칙: ../../docs/db/conventions.md §7
#
# 값은 apps/dh-backend / apps/portal-backend의 .env.local과 같은 Supabase 프로젝트를 가리킨다.
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# 두 값 다 "Direct connection" 탭이 아니라 pooler 호스트(aws-0-[region].pooler.supabase.com)를
# 쓴다. 진짜 Direct connection(db.[project-ref].supabase.co)은 IPv6 전용이라 IPv4만 되는
# 일반 네트워크에서는 그냥 막힌다.

# Transaction pooler (포트 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (포트 5432, 같은 pooler 호스트) -- prisma migrate가 실제로 쓰는 연결.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# === 로컬 리허설용 ===
# 운영 DB를 건드리는 마이그레이션은 로컬 Postgres에서 먼저 돌려본다(conventions.md §12).
# 그때는 위 두 값을 아래처럼 로컬로 바꿔서 실행한다.
# DATABASE_URL="postgresql://postgres:[password]@localhost:5432/dhbot_rehearsal"
# DIRECT_URL="postgresql://postgres:[password]@localhost:5432/dhbot_rehearsal"
