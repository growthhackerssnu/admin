// admin.ghsnu.com이 공유하는 Postgres의 물리 스키마 원본.
//
// 이 파일이 DB 구조의 유일한 소스다. 마이그레이션도, apps/backend가 쓰는 Prisma
// Client도 이 파일 하나에서 나온다. 규칙: docs/db/conventions.md §7
//
// 스키마 경계 (§2, §3):
//   core — 세 앱이 공유하는 신원·회원 데이터. 소유자는 portal.
//   dh   — 대협봇 업무 데이터. 소유자는 dh. 다른 앱은 접근하지 않는다.
//   ghbot — GH Bot 접근 토큰. 소유자는 portal.
//   hr   — 그핵드인 업무 데이터. 소유자는 hr. edit_requests/people_cache 2개
//          (DB_SCHEMA_HR.md 참고). 다른 앱은 접근하지 않는다.
//
// 설계 근거: docs/admin/integration/05_데이터 모델 제안.md (목업 기준 테이블 설계).
// 사람 검토 파이프라인의 뉴스레터 수집 원문·기업명은 dh에 저장한다.
// DB 컬럼(snake_case)과 API DTO(camelCase)의 이름 차이는 각 앱의 serializer가 흡수한다.

// Prisma Client는 apps/backend의 postinstall(prisma generate --schema 이 파일)이
// 아래 output으로 생성한다. 이 패키지의 스크립트는 --skip-generate로 실행한다.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../../apps/backend/src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["core", "dh", "ghbot", "hr", "nut"]
}

// ---------- Enums ----------

// admin: admin@ghsnu.com 고정, 전 영역 접근·편집·회원 승인/삭제.
// acting: 현재 액팅 회원. dh+hr 업무 권한 전부 동일(PM 서브권한 없음).
// alumni: 가입한 알럼나이. hr은 보기 전용, dh(대협봇)는 접근 자체 불가.
enum Role {
  admin
  acting
  alumni
  @@schema("core")
}

// 운영팀 직책 — acting 회원에게만 붙는다(alumni·admin은 없다). 한 사람이 여럿을
// 가질 수 있고 core.member_ops_roles에 한 줄씩 들어간다(MemberOpsRole 참고).
//
// 직책(회장·부회장·총무·각 팀장)은 한 사람이 하나만, 팀원은 여러 팀에 동시에
// 할 수 있다(예: 총무이면서 대외협력 팀원·에듀 팀원). 같은 직책은 기수당 한 명이라
// 인수인계 기간엔 19기 회장과 20기 회장이 함께 있을 수 있다. 이 규칙들은 Prisma
// 문법으로 표현할 수 없어서 마이그레이션 SQL의 부분 유니크 인덱스로 걸었다
// (conventions.md §7.3).
//
// enum 값은 추가만 한다(§8).
enum OpsRole {
  president       // 회장
  vice_president  // 부회장
  treasurer       // 총무
  external_lead   // 대외협력 팀장
  external_member // 대외협력 팀원
  hr_lead         // HR 팀장
  hr_member       // HR 팀원
  pr_lead         // PR 팀장
  pr_member       // PR 팀원
  edu_lead        // 에듀 팀장
  edu_member      // 에듀 팀원
  @@schema("core")
}

enum Channel {
  email
  linkedin
  @@schema("dh")
}

enum Route {
  new
  alternate_contact
  recontact
  repeat_collaboration
  @@schema("dh")
}

enum WorkStage {
  company_review
  recipient_selection
  draft_review
  ready_to_send
  response_check
  @@schema("dh")
}

// skipped_for_cycle은 차수 개념을 폐지하면서 쓰지 않는다. enum 값은 추가만 가능하고
// 삭제할 수 없어서(conventions §8) 자리만 남겨두고 skipped_for_quarter를 쓴다.
enum InternalDecision {
  active
  skipped_for_cycle
  excluded_permanently
  skipped_for_quarter
  @@schema("dh")
}

enum ResponseResult {
  no_reply
  discussing
  rejected
  deferred
  referred
  closed
  @@schema("dh")
}

enum ResponseCategory {
  resource_shortage
  not_interested
  no_problem_demand
  other
  @@schema("dh")
}

enum SendStatus {
  queued
  sending
  sent
  failed
  unknown
  @@schema("dh")
}

enum OutreachSendStatus {
  before_send
  sent
  @@schema("dh")
}

enum OutcomeStatus {
  pending
  won
  rejected
  unresolved
  @@schema("dh")
}

enum ProjectStatus {
  won
  in_progress
  completed
  @@schema("dh")
}

enum OutcomeEventSource {
  manual
  send_record
  round_close
  @@schema("dh")
}

enum JobType {
  cycle_search
  contact_search
  draft_generate
  @@schema("dh")
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  @@schema("dh")
}

enum DraftOrigin {
  ai
  admin_edit
  @@schema("dh")
}

// ---------- 사용자 ----------

// 접근은 화이트리스트 방식이다. 관리자가 이메일로 행을 미리 만들어야 로그인이
// 완성된다(Google 인증 + 도메인 통과만으로는 접근이 열리지 않는다). 미리 만들
// 때는 supabaseUserId를 모르므로 nullable — 첫 로그인 때 연결한다.
model Member {
  id             String   @id @default(cuid())
  supabaseUserId String?  @unique @map("supabase_user_id")
  email          String   @unique
  displayName    String   @map("display_name")
  role           Role     @default(acting)
  // 예전의 1인 1직책 컬럼. 이제 아무도 읽거나 쓰지 않는다 — 직책은 opsRoles(core.member_ops_roles)에 있다.
  // expand-contract(conventions.md §9.2)의 축소 단계에서 지운다. alumni로 내릴 때만 NULL로 비운다
  // (CHECK 제약 members_ops_role_acting_only 때문에).
  legacyOpsRole  OpsRole? @map("ops_role")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  lastLoginAt    DateTime? @map("last_login_at")

  opsRoles            MemberOpsRole[]

  quarterChanges      OutreachTargetQuarterChange[] @relation("QuarterChangedBy")
  confirmedContacts   ContactOptionAssessment[]     @relation("ContactConfirmedBy")
  assignedSearchRuns  SearchRun[]          @relation("SearchRunAssignee")
  ownedOutreaches     Outreach[]           @relation("OutreachOwner")
  decidedOutreaches   Outreach[]           @relation("OutreachDecidedBy")
  checkedResponses    Response[]
  createdSearchRuns   SearchRun[]          @relation("SearchRunCreatedBy")
  fitDecisions        HumanFitDecision[]   @relation("FitDecisionDecidedBy")
  dhIdempotencyKeys   DhIdempotencyKey[]   @relation("DhIdempotencyActor")
  coreIdempotencyKeys CoreIdempotencyKey[] @relation("CoreIdempotencyActor")
  reviewCandidates    Candidate[]           @relation("CandidateReviewOwner")
  reviewDecisions     CandidateReviewDecision[] @relation("CandidateReviewDecider")
  recordedSends       SentMessage[] @relation("SentMessageRecordedBy")
  createdReviewAssignmentBatches ReviewAssignmentBatch[] @relation("ReviewAssignmentBatchCreator")
  reviewAssignmentItems ReviewAssignmentItem[] @relation("ReviewAssignmentItemMember")
  changedCollectionIntake CollectionIntakeControl[] @relation("CollectionIntakeChangedBy")
  claimedPersonEntry  PeopleDirectory?
  ghbotTokens         GhbotAccessToken[] @relation("GhbotTokenMember")
  ghbotTokensIssued   GhbotAccessToken[] @relation("GhbotTokenIssuer")
  createdAcquisitionRounds AcquisitionRound[] @relation("AcquisitionRoundCreator")
  closedAcquisitionRounds  AcquisitionRound[] @relation("AcquisitionRoundCloser")
  outcomeEvents       OutreachOutcomeEvent[] @relation("OutcomeEventActor")
  ownedPastProjects   PastProject[] @relation("PastProjectOwner")
  createdPastProjects PastProject[] @relation("PastProjectCreator")
  updatedPastProjects PastProject[] @relation("PastProjectUpdater")

  // hr(그핵드인) — 프로필 수정 승인 큐. 본인이 제출한 요청(alumni 포함 누구나)과
  // 자신이 검토한 요청(admin)은 서로 다른 관계다. DB_SCHEMA_HR.md §1 참고.
  editRequestsSubmitted EditRequest[] @relation("EditRequestRequester")
  editRequestsReviewed  EditRequest[] @relation("EditRequestReviewer")

  @@map("members")
  @@schema("core")
}

// 운영팀 직책 배정. 한 회원이 여러 줄을 가질 수 있다(직책 하나 + 팀원 여럿).
// cohort는 직책(회장·부회장·총무·팀장)을 맡은 사람의 기수다(19기는 19기 회장만 — 지정할 때
// 그핵드인 명단에서 채운다). 같은 직책은 기수마다 한 명이라 인수인계 기간엔 두 기수의 회장이
// 함께 있을 수 있다. 팀원은 cohort가 NULL이다.
// 마이그레이션 SQL의 부분 유니크 인덱스가 지키는 규칙:
//   member_ops_roles_one_office_key            한 사람은 직책을 하나만
//   member_ops_roles_office_cohort_key         같은 직책·같은 기수는 한 명만
//   member_ops_roles_office_unknown_cohort_key 기수를 모르는(옛 데이터) 같은 직책은 한 명만
// acting에게만 있다는 규칙은 API(portal)가 지킨다 — alumni로 내리면 지운다.
model MemberOpsRole {
  memberId  String   @map("member_id")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  opsRole   OpsRole  @map("ops_role")
  cohort    Int?
  createdAt DateTime @default(now()) @map("created_at")

  @@id([memberId, opsRole])
  @@index([opsRole])
  @@map("member_ops_roles")
  @@schema("core")
}

// ghbot의 구성원 로그인용 장기 토큰. 인증에는 SHA-256 해시를 쓰고, 관리자
// 재복사용 원문은 암호문으로만 저장한다. 이 레코드는 portal이 소유하고 ghbot
// 서버는 내부 검증 API를 통해서만 확인한다.
model GhbotAccessToken {
  id               String    @id @default(cuid())
  memberId         String    @map("member_id")
  member           Member    @relation("GhbotTokenMember", fields: [memberId], references: [id])
  tokenHash        String    @unique @map("token_hash")
  tokenCiphertext  String    @map("token_ciphertext")
  tokenPrefix      String    @map("token_prefix")
  issuedByMemberId String    @map("issued_by_member_id")
  issuedBy         Member    @relation("GhbotTokenIssuer", fields: [issuedByMemberId], references: [id])
  issuedAt         DateTime  @default(now()) @map("issued_at")
  lastUsedAt       DateTime? @map("last_used_at")
  expiresAt        DateTime? @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  @@index([memberId])
  @@index([revokedAt])
  @@map("ghbot_access_tokens")
  @@schema("ghbot")
}

// ghbot MCP 서버의 OAuth 상태(동적 등록 클라이언트, 인가 코드, 액세스·리프레시
// 토큰). ghbot이 컨테이너 디스크의 SQLite에 두던 것을 옮겼다 — 인스턴스가 내려가도
// claude.ai 연결이 유지되게. 키는 "client:<id>" 또는 "<종류>:<sha256(비밀값)>"이라
// 원문 토큰은 저장하지 않는다. ghbot은 내부 API(oauth-store)로만 접근한다.
model GhbotOauthEntry {
  key       String    @id
  data      Json
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_entries")
  @@schema("ghbot")
}

// 노션 People DB(액팅+알럼나이 전체)에서 가져온 "신뢰 이메일" 원장
// (apps/backend(portal)의 npm run people:import로 동기화). 딱 하나만 한다: 가입 신청 시 기수+이름으로
// 이 테이블을 찾아 knownEmail로 OTP를 보내서 "진짜 명단에 있는 사람"인지
// 확인한다. role(acting/alumni)은 여기서 판단하지 않는다 — 가입 직후엔 무조건
// alumni로 등록되고, admin이 나중에 개별로 acting으로 올린다.
// claimedByMemberId가 채워지면 이미 가입이 끝난 것 — 같은 항목으로 두 번
// 가입하는 걸 막는다.
model PeopleDirectory {
  id                String    @id @default(cuid())
  notionPageId      String    @unique @map("notion_page_id")
  cohort            String
  cohortNormalized  String    @map("cohort_normalized")
  name              String
  nameNormalized    String    @map("name_normalized")
  knownEmail        String    @map("known_email")
  claimedByMemberId String?   @unique @map("claimed_by_member_id")
  claimedBy         Member?   @relation(fields: [claimedByMemberId], references: [id])
  claimedAt         DateTime? @map("claimed_at")
  importedAt        DateTime  @default(now()) @map("imported_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  signupRequests SignupRequest[]

  @@index([cohortNormalized, nameNormalized])
  @@map("people_directory")
  @@schema("core")
}

enum SignupRequestStatus {
  pending
  verified
  expired
  @@schema("core")
}

// 기수+이름+원하는 구글 이메일로 가입 신청 → people_directory에서 대조한
// knownEmail로 OTP 발송 → 인증 성공 시 그 구글 이메일로 members 행 생성
// (role = alumni 고정, admin이 나중에 acting으로 승격).
model SignupRequest {
  id                String              @id @default(cuid())
  personDirectoryId String              @map("person_directory_id")
  personDirectory   PeopleDirectory     @relation(fields: [personDirectoryId], references: [id])
  desiredEmail      String              @map("desired_email")
  otpHash           String              @map("otp_hash")
  otpExpiresAt      DateTime            @map("otp_expires_at")
  attempts          Int                 @default(0)
  status            SignupRequestStatus @default(pending)
  createdAt         DateTime            @default(now()) @map("created_at")
  verifiedAt        DateTime?           @map("verified_at")

  @@map("signup_requests")
  @@schema("core")
}

// ---------- 목표 분기 ----------

// 수주 목표 분기 — 컨택을 추진할 시기의 라벨이다(P-01).
//
// **실제 발송 시기가 아니다.** 4분기를 목표로 잡은 기업에 9월에 보냈다면 운영 지표는
// 3분기로 집계한다(P-15). 지표는 sent_messages.sent_at을 한국 달력 분기로 변환해
// 세며, 이 테이블은 거기에 관여하지 않는다.
//
// 전역 "현재 분기" 상태는 두지 않는다. 메시지 준비 시 컨택 건에서 목표 분기를 선택한다.
model TargetQuarter {
  id        String   @id @default(cuid())
  year      Int
  quarter   Int
  createdAt DateTime @default(now()) @map("created_at")

  currentOutreaches  Outreach[]                   @relation("OutreachQuarter")
  lastSentOutreaches Outreach[]                   @relation("OutreachLastSentQuarter")
  skipOutreaches     Outreach[]                   @relation("OutreachSkipQuarter")
  sentMessages       SentMessage[]
  draftRevisions    MessageDraftRevision[] @relation("DraftTargetQuarter")
  searchRuns         SearchRun[]
  acquisitionRounds  AcquisitionRound[]
  changedFrom        OutreachTargetQuarterChange[] @relation("QuarterChangeFrom")
  changedTo          OutreachTargetQuarterChange[] @relation("QuarterChangeTo")

  @@unique([year, quarter])
  @@index([year(sort: Desc), quarter(sort: Desc)])
  @@map("target_quarters")
  @@schema("dh")
}

// 발송 전 목표 분기 이동의 감사 이력(P-16). 현재 분기 변경과 같은 트랜잭션에서
// append-only로 쌓는다. 원발견 배치와 당시 분기는 바뀌지 않는다.
model OutreachTargetQuarterChange {
  id                  String        @id @default(cuid())
  outreachId          String        @map("outreach_id")
  outreach            Outreach      @relation(fields: [outreachId], references: [id])
  fromTargetQuarterId String        @map("from_target_quarter_id")
  fromTargetQuarter   TargetQuarter @relation("QuarterChangeFrom", fields: [fromTargetQuarterId], references: [id])
  toTargetQuarterId   String        @map("to_target_quarter_id")
  toTargetQuarter     TargetQuarter @relation("QuarterChangeTo", fields: [toTargetQuarterId], references: [id])
  changedById         String        @map("changed_by_id")
  changedBy           Member        @relation("QuarterChangedBy", fields: [changedById], references: [id])
  changedAt           DateTime      @default(now()) @map("changed_at")
  reason              String?

  @@index([outreachId, changedAt(sort: Desc)])
  @@map("outreach_target_quarter_changes")
  @@schema("dh")
}

// ---------- 기업 ----------

// 발견(리스트업)과 발송(컨택)이 공유하는 기업 식별 정보다. 컬럼 소유권을 나눠 쓴다:
//   발견 쪽 — name, legal_name, aliases, website_url, canonical_domain, created_at, updated_at
//   발송 쪽 — product, domain, permanently_excluded*, is_prelaunch_only, version
// 서로 상대 영역의 컬럼을 쓰지 않는다. product/domain은 발견 단계에서 채울 수 없어서
// nullable이다 — 발송 화면이 쓰던 값이라 비어 있을 수 있다는 뜻이다.
model Company {
  id                        String    @id @default(cuid())
  name                      String
  legalName                 String?   @map("legal_name")
  aliases                   String[]  @default([])
  websiteUrl                String?   @map("website_url")
  canonicalDomain           String?   @map("canonical_domain")
  product                   String?
  domain                    String?
  version                   Int       @default(1)
  permanentlyExcluded       Boolean   @default(false) @map("permanently_excluded")
  permanentlyExcludedReason String?   @map("permanently_excluded_reason")
  permanentlyExcludedAt     DateTime? @map("permanently_excluded_at")
  isPrelaunchOnly           Boolean   @default(false) @map("is_prelaunch_only")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  contacts           Contact[]
  contactEndpoints   ContactEndpoint[]
  prelaunchContacts  PrelaunchContact[]
  outreaches         Outreach[]
  pastProjects       PastProject[]
  evidence           Evidence[]
  researches         CompanyResearch[]
  candidates         Candidate[]
  collectedCompanies CollectedCompany[]
  nameKeys           CompanyNameKey[]

  @@index([canonicalDomain])
  @@map("companies")
  @@schema("dh")
}

// 기업 관계자. 발견(리스트업)과 발송(컨택)이 같은 행을 쓴다 — 명세 v0.4 §8.4가
// "이미 있는 물리 모델에 같은 목적의 새 테이블을 중복 생성하지 않는다"고 못박았다.
// 재직 여부와 그 확인 근거는 연락 가능성 판단에 쓰고, 같은 이름이라고 자동으로
// 합치지 않는다.
model Contact {
  id                  String           @id @default(cuid())
  companyId           String           @map("company_id")
  company             Company          @relation(fields: [companyId], references: [id])
  name                String
  title               String?
  role                String?
  department          String?
  jobFunction         JobFunction      @default(unknown) @map("job_function")
  seniority           Seniority        @default(unknown)
  employmentStatus    EmploymentStatus @default(unknown) @map("employment_status")
  employmentCheckedAt DateTime?        @map("employment_checked_at")
  evidenceIds         String[]         @default([]) @map("evidence_ids")
  // linkedinUrl은 endpoint와 중복이라 신규 쓰기를 중단한다. 기존 값은 이관 후 읽기 전용.
  linkedinUrl         String?          @map("linkedin_url")
  createdAt           DateTime         @default(now()) @map("created_at")

  endpoints             ContactEndpoint[]
  recipientOnOutreaches Outreach[]        @relation("OutreachRecipientContact")
  recipientOnSends      SentMessage[]     @relation("SentMessageRecipientContact")
  selectedOnCandidates Candidate[]       @relation("CandidateSelectedContact")
  candidateReviewDecisions CandidateReviewDecision[] @relation("CandidateDecisionContact")
  draftRecipients MessageDraftRevision[] @relation("DraftRecipientContact")
  pastProjects    PastProject[]

  @@index([companyId])
  @@map("contacts")
  @@schema("dh")
}

// 연락 수단. 개인·팀·대표 메일을 모두 표현한다(P-10).
// valid 불리언 하나로는 "프로필은 찾았지만 이 사람 것인지 모름"과 "형식은 맞지만
// 실제 도달은 미확인"을 구분할 수 없어서, 소유·형식·도달을 따로 기록한다.
model ContactEndpoint {
  id                 String             @id @default(cuid())
  companyId          String             @map("company_id")
  company            Company            @relation(fields: [companyId], references: [id])
  contactId          String?            @map("contact_id")
  contact            Contact?           @relation(fields: [contactId], references: [id])
  ownerType          ChannelOwnerType   @default(person) @map("owner_type")
  channel            Channel
  address            String
  discoveryMethod    DiscoveryMethod    @default(public_source) @map("discovery_method")
  ownershipStatus    OwnershipStatus    @default(uncertain) @map("ownership_status")
  validationStatus   ValidationStatus   @default(not_checked) @map("validation_status")
  reachabilityStatus ReachabilityStatus @default(unknown) @map("reachability_status")
  linkedinMethods    LinkedinMethod[]   @map("linkedin_methods")
  evidenceIds        String[]           @default([]) @map("evidence_ids")
  checkedAt          DateTime?          @map("checked_at")
  // 레거시. ownershipStatus/validationStatus로 점진 대체한다.
  valid              Boolean            @default(true)
  createdAt          DateTime           @default(now()) @map("created_at")

  optionAssessments     ContactOptionAssessment[]
  recipientOnOutreaches Outreach[]                @relation("OutreachRecipientEndpoint")
  recipientOnSends      SentMessage[]             @relation("SentMessageRecipientEndpoint")
  selectedOnCandidates Candidate[]               @relation("CandidateSelectedEndpoint")
  candidateReviewDecisions CandidateReviewDecision[] @relation("CandidateDecisionEndpoint")
  draftRecipients MessageDraftRevision[] @relation("DraftRecipientEndpoint")

  @@unique([companyId, channel, address])
  @@index([companyId])
  @@map("contact_endpoints")
  @@schema("dh")
}

// 배포 전 이력만 있는 수신자를 제외 목적으로만 기록하는 최소 레코드.
// 정식 Contact 레코드가 없어도(엑셀 이관 등) 이름/이메일/링크드인으로 매칭해 후보에서 뺀다.
model PrelaunchContact {
  id           String  @id @default(cuid())
  companyId    String  @map("company_id")
  company      Company @relation(fields: [companyId], references: [id])
  name         String
  email        String?
  linkedinUrl  String? @map("linkedin_url")
  note         String?

  @@map("prelaunch_contacts")
  @@schema("dh")
}

// ---------- 수주 회차 ----------
// 팀장·관리자가 목표 분기를 설정한 시점부터 다음 변경 시점까지가 한 회차다.
// 진행 중(ended_at IS NULL) 회차는 전체에서 한 건만 허용한다 — 수기 부분 unique 인덱스.
model AcquisitionRound {
  id              String        @id @default(cuid())
  targetQuarterId String        @map("target_quarter_id")
  targetQuarter   TargetQuarter @relation(fields: [targetQuarterId], references: [id])
  startedAt       DateTime      @map("started_at")
  endedAt         DateTime?     @map("ended_at")
  createdById     String        @map("created_by_id")
  createdBy       Member        @relation("AcquisitionRoundCreator", fields: [createdById], references: [id])
  closedById      String?       @map("closed_by_id")
  closedBy        Member?       @relation("AcquisitionRoundCloser", fields: [closedById], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  outreaches Outreach[]

  @@map("acquisition_rounds")
  @@schema("dh")
}

// 수주 결과 변경 이력. append-only. 현재 값은 outreaches.outcome_status.
model OutreachOutcomeEvent {
  id         String             @id @default(cuid())
  outreachId String             @map("outreach_id")
  outreach   Outreach           @relation(fields: [outreachId], references: [id])
  fromStatus OutcomeStatus?     @map("from_status")
  toStatus   OutcomeStatus      @map("to_status")
  note       String?
  source     OutcomeEventSource
  actorId    String?            @map("actor_id")
  actor      Member?            @relation("OutcomeEventActor", fields: [actorId], references: [id])
  recordedAt DateTime           @default(now()) @map("recorded_at")

  @@index([outreachId, recordedAt, id])
  @@map("outreach_outcome_events")
  @@schema("dh")
}

// ---------- 컨택 건 ----------
// 기업·수주 회차당 Outreach는 한 행이다(unique company_id + acquisition_round_id).
// 회차 연결 전의 과거 행은 acquisition_round_id가 NULL이다. 회차 안에서는
// 첫 발송 한 번만 허용한다. 과거 SentMessage는 변경하지 않는다.

model Outreach {
  id                    String            @id @default(cuid())
  companyId             String            @map("company_id")
  company               Company           @relation(fields: [companyId], references: [id])
  acquisitionRoundId    String?           @map("acquisition_round_id")
  acquisitionRound      AcquisitionRound? @relation(fields: [acquisitionRoundId], references: [id])
  previousOutreachId    String?           @map("previous_outreach_id")
  previousOutreach      Outreach?         @relation("OutreachPrevious", fields: [previousOutreachId], references: [id])
  nextOutreaches        Outreach[]        @relation("OutreachPrevious")
  outcomeStatus         OutcomeStatus?    @map("outcome_status")
  candidateId           String?           @map("candidate_id")
  candidate             Candidate?        @relation(fields: [candidateId], references: [id])
  contactPurpose        String?           @map("contact_purpose")
  sendStatus            OutreachSendStatus? @map("send_status")
  ownerId               String            @map("owner_id")
  owner                 Member            @relation("OutreachOwner", fields: [ownerId], references: [id])
  currentTargetQuarterId String           @map("current_target_quarter_id")
  currentTargetQuarter  TargetQuarter     @relation("OutreachQuarter", fields: [currentTargetQuarterId], references: [id])

  route                 Route
  workStage             WorkStage         @map("work_stage")
  internalDecision      InternalDecision  @default(active) @map("internal_decision")
  version               Int               @default(1)

  recipientContactId    String?           @map("recipient_contact_id")
  recipientContact      Contact?          @relation("OutreachRecipientContact", fields: [recipientContactId], references: [id])
  recipientEndpointId   String?           @map("recipient_endpoint_id")
  recipientEndpoint     ContactEndpoint?  @relation("OutreachRecipientEndpoint", fields: [recipientEndpointId], references: [id])

  lastSentQuarterId     String?           @map("last_sent_quarter_id")
  lastSentQuarter       TargetQuarter?          @relation("OutreachLastSentQuarter", fields: [lastSentQuarterId], references: [id])

  reviewNote            String?           @map("review_note")
  conditionEvidence     String?           @map("condition_evidence")
  reviewedAt            DateTime?         @map("reviewed_at")
  decidedById           String?           @map("decided_by_id")
  decidedBy             Member?           @relation("OutreachDecidedBy", fields: [decidedById], references: [id])
  decidedAt             DateTime?         @map("decided_at")

  skipNote              String?           @map("skip_note")
  skipQuarterId         String?           @map("skip_quarter_id")
  skipQuarter           TargetQuarter?          @relation("OutreachSkipQuarter", fields: [skipQuarterId], references: [id])

  currentRevision       Int?              @map("current_revision")
  approvedRevision      Int?              @map("approved_revision")

  // 원발견 배치는 불변이다. 목표 분기를 옮겨도 "언제 처음 찾았는지"는 바뀌지 않는다(P-16).
  originSearchRunId     String?           @map("origin_search_run_id")
  originSearchRun       SearchRun?        @relation(fields: [originSearchRunId], references: [id])
  // 사람이 고른 채널. 사람이 수신자를 골랐다는 이유로 서버가 채널을 정하지 않는다(P-09).
  selectedChannel       Channel?          @map("selected_channel")
  // 수신자·채널이 바뀌면 증가한다. 이메일 최종 확인 결과를 무효화하는 기준이다.
  selectionVersion      Int               @default(0) @map("selection_version")
  currentDraftRevision  Int?              @map("current_draft_revision")

  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  draftRevisions        MessageDraftRevision[]
  sentMessages          SentMessage[]
  responses             Response[]
  targetQuarterChanges  OutreachTargetQuarterChange[]
  outcomeEvents         OutreachOutcomeEvent[]
  sourcedProject        PastProject?

  @@unique([companyId, acquisitionRoundId])
  @@index([candidateId])
  @@index([acquisitionRoundId, ownerId])
  @@index([acquisitionRoundId, outcomeStatus])
  @@index([currentTargetQuarterId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workStage, updatedAt(sort: Desc)])
  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@map("outreaches")
  @@schema("dh")
}

// ---------- 템플릿·초안 ----------

model Template {
  id              String   @id @default(cuid())
  route           Route
  channel         Channel
  version         Int
  subjectTemplate String   @map("subject_template")
  bodyTemplate    String   @map("body_template")
  active          Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  draftRevisions MessageDraftRevision[]
  sentMessages   SentMessage[]

  // route x channel 조합당 active = true는 하나만 허용 — 애플리케이션 레이어에서 강제
  // (부분 유니크 인덱스가 필요하면 마이그레이션에 raw SQL로 추가)
  @@map("templates")
  @@schema("dh")
}

// 초안은 수정할 때마다 새 리비전 행을 추가하는 append-only 이력이다.
// outreaches.currentRevision/approvedRevision이 "지금 보여줄 값"을 가리킨다.
model MessageDraftRevision {
  id              String      @id @default(cuid())
  outreachId      String      @map("outreach_id")
  outreach        Outreach    @relation(fields: [outreachId], references: [id])
  revision        Int
  topic           String
  subject         String
  body            String
  templateId      String?     @map("template_id")
  template        Template?   @relation(fields: [templateId], references: [id])
  templateVersion Int?        @map("template_version")
  createdBy       DraftOrigin @map("created_by")
  createdAt       DateTime    @default(now()) @map("created_at")
  generationResearchId       String?    @map("generation_research_id")
  generationResearch         CompanyResearch? @relation(fields: [generationResearchId], references: [id])
  generationReviewDecisionId String?    @map("generation_review_decision_id")
  generationReviewDecision   CandidateReviewDecision? @relation(fields: [generationReviewDecisionId], references: [id])
  recipientContactId         String?    @map("recipient_contact_id")
  recipientContact           Contact?   @relation("DraftRecipientContact", fields: [recipientContactId], references: [id])
  recipientEndpointId        String?    @map("recipient_endpoint_id")
  recipientEndpoint          ContactEndpoint? @relation("DraftRecipientEndpoint", fields: [recipientEndpointId], references: [id])
  recipientSnapshot          Json?      @map("recipient_snapshot")
  targetQuarterId            String?    @map("target_quarter_id")
  targetQuarter              TargetQuarter? @relation("DraftTargetQuarter", fields: [targetQuarterId], references: [id])
  contactPurposeSnapshot     String?    @map("contact_purpose_snapshot")
  historySourceIds           Json?      @map("history_source_ids")
  generationHistory          Json?      @map("generation_history")

  @@unique([outreachId, revision])
  @@map("message_draft_revisions")
  @@schema("dh")
}

// ---------- 발송·응답 ----------

model SentMessage {
  id                     String      @id @default(cuid())
  outreachId             String      @map("outreach_id")
  outreach               Outreach    @relation(fields: [outreachId], references: [id])
  targetQuarterId        String      @map("target_quarter_id")
  targetQuarter          TargetQuarter @relation(fields: [targetQuarterId], references: [id])
  channel                Channel
  recipientContactId     String      @map("recipient_contact_id")
  recipientContact       Contact     @relation("SentMessageRecipientContact", fields: [recipientContactId], references: [id])
  recipientEndpointId    String      @map("recipient_endpoint_id")
  recipientEndpoint      ContactEndpoint @relation("SentMessageRecipientEndpoint", fields: [recipientEndpointId], references: [id])
  recipientNameSnapshot  String      @map("recipient_name_snapshot")
  addressSnapshot        String      @map("address_snapshot")
  subjectSnapshot        String      @map("subject_snapshot")
  bodySnapshot           String      @map("body_snapshot")
  templateId             String?     @map("template_id")
  template               Template?   @relation(fields: [templateId], references: [id])
  templateVersion        Int?        @map("template_version")
  status                 SendStatus  @default(sent)
  sentAt                 DateTime    @map("sent_at")
  createdAt              DateTime    @default(now()) @map("created_at")
  draftRevision          Int?        @map("draft_revision")
  recordedById           String?     @map("recorded_by_id")
  recordedBy             Member?     @relation("SentMessageRecordedBy", fields: [recordedById], references: [id])

  responses Response[]

  @@unique([outreachId, draftRevision])
  @@index([outreachId, sentAt, id])
  @@map("sent_messages")
  @@schema("dh")
}

// 응답 확인 결과. append-only — 같은 outreach에 여러 행이 쌓이고 최신 행이 현재 값이다.
model Response {
  id                String            @id @default(cuid())
  outreachId        String            @map("outreach_id")
  outreach          Outreach          @relation(fields: [outreachId], references: [id])
  sentMessageId     String?           @map("sent_message_id")
  sentMessage       SentMessage?      @relation(fields: [sentMessageId], references: [id])
  result            ResponseResult
  category          ResponseCategory?
  explanation       String?
  revisitCondition  String?           @map("revisit_condition")
  checkedById       String            @map("checked_by_id")
  checkedBy         Member            @relation(fields: [checkedById], references: [id])
  checkedAt         DateTime          @default(now()) @map("checked_at")

  @@map("responses")
  @@schema("dh")
}

// ---------- 과거 협업 ----------

model PastProject {
  id                 String  @id @default(cuid())
  companyId          String  @map("company_id")
  company            Company @relation(fields: [companyId], references: [id])
  // Notion row identity. Nullable for the one-time migration of legacy rows;
  // all imported rows must set it and use it as the upsert key.
  notionPageId       String? @unique @map("notion_page_id")
  // One-line project description. `summary` remains temporarily for legacy seed/data.
  title              String
  summary            String?
  year               Int?
  quarter            Int?
  technologyCategory String? @map("technology_category")
  industryCategory   String? @map("industry_category")
  notionUrl          String? @map("notion_url")

  // 팀장·관리자가 직접 등록·수정하는 협업 프로젝트 정보. 과거에 가져온 행은 상태·담당자가
  // 확인되지 않았으므로 null로 두며 완료로 간주하지 않는다.
  status             ProjectStatus?
  resultUrl          String?  @map("result_url")
  ownerId            String?  @map("owner_id")
  owner              Member?  @relation("PastProjectOwner", fields: [ownerId], references: [id])
  contactId          String?  @map("contact_id")
  contact            Contact? @relation(fields: [contactId], references: [id])
  // 수주 완료에서 이어진 프로젝트. 같은 수주 작업에서 두 번 등록하지 못하게 unique다.
  sourceOutreachId   String?  @unique @map("source_outreach_id")
  sourceOutreach     Outreach? @relation(fields: [sourceOutreachId], references: [id])
  version            Int      @default(1)
  createdById        String?  @map("created_by_id")
  createdBy          Member?  @relation("PastProjectCreator", fields: [createdById], references: [id])
  updatedById        String?  @map("updated_by_id")
  updatedBy          Member?  @relation("PastProjectUpdater", fields: [updatedById], references: [id])
  // 시스템이 기록한 시각이다. 과거 프로젝트가 진행된 시기가 아니다.
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([companyId, year, quarter])

  @@map("past_projects")
  @@schema("dh")
}

// ---------- 비동기 작업 ----------

model Job {
  id          String    @id @default(cuid())
  type        JobType
  status      JobStatus @default(queued)
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id")
  resultRef   Json?     @map("result_ref")
  error       String?
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("jobs")
  @@schema("dh")
}

// ---------- 멱등성 ----------

// POST/PUT/PATCH 변경 요청의 Idempotency-Key를 기록한다. 같은 키로 재시도가 오면
// 새 버전 검사보다 먼저 이 테이블을 조회해 이전에 성공한 응답을 그대로 재반환한다.
//
// 이건 공유 도메인 데이터가 아니라 각 앱의 내부 구현 디테일이라, 스키마마다 자기
// 테이블을 갖는다(conventions.md §4.1). 한 테이블을 공유하면 서로 다른 앱의 키가
// 한 네임스페이스에 섞여서, 우연히 같은 Idempotency-Key를 받으면 남의 응답을
// 돌려주거나 IDEMPOTENCY_CONFLICT가 난다.
//
// 물리 테이블 이름(idempotency_keys)은 같고 스키마만 다르다 — 이게 multiSchema의
// 용도다. 각 앱의 schema.prisma에는 자기 것 하나만 IdempotencyKey라는 이름으로
// 선언하므로, 앱 코드(src/lib/idempotency.ts)는 이 분리를 알 필요가 없다.

model DhIdempotencyKey {
  key             String   @id
  actorMemberId   String   @map("actor_member_id")
  actorMember     Member   @relation("DhIdempotencyActor", fields: [actorMemberId], references: [id])
  route           String
  requestHash     String   @map("request_hash")
  responseStatus  Int      @map("response_status")
  responseBody    Json     @map("response_body")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
  @@schema("dh")
}

model CoreIdempotencyKey {
  key             String   @id
  actorMemberId   String   @map("actor_member_id")
  actorMember     Member   @relation("CoreIdempotencyActor", fields: [actorMemberId], references: [id])
  route           String
  requestHash     String   @map("request_hash")
  responseStatus  Int      @map("response_status")
  responseBody    Json     @map("response_body")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
  @@schema("core")
}

// ---------- 리스트업(기업 발견·판단·연락처) ----------
//
// 리스트업_데이터스키마_API명세_v0.1.md의 논리 스키마를 물리 테이블로 옮긴 것이다.
// 명세의 workspace_id는 도입하지 않는다 — GH SNU 단일 조직이라 칸막이가 필요 없다.
//
// evidence 참조는 join 테이블 대신 String[]로 둔다. 구조가 같은 join 테이블이 다섯 개
// 생길 만한 값이 없고, 읽기는 항상 id 목록으로 한 번에 가져온다. evidence는 append-only라
// 끊긴 참조가 생기지 않으며, 참조 무결성은 앱이 보장한다(conventions.md §4에 기록).
//
// enum 타입 이름은 Postgres 스키마 안에서 전역 유일해야 한다. queued/running 같은 값은
// 기존 JobStatus·SendStatus에도 있어서, 새 enum은 전부 이름을 구분해서 붙였다.

enum SearchRunStatus {
  queued
  running
  completed
  partially_completed
  failed
  cancelled
  @@schema("dh")
}

enum ClaimCategory {
