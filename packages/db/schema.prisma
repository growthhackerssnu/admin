}

enum JobFunction {
  executive
  business_development
  product
  data
  other
  unknown
  @@schema("dh")
}

enum Seniority {
  c_level
  manager
  individual_contributor
  unknown
  @@schema("dh")
}

enum EmploymentStatus {
  current
  former
  unknown
  @@schema("dh")
}

enum ChannelOwnerType {
  person
  team
  company
  @@schema("dh")
}

enum DiscoveryMethod {
  public_source
  user_provided
  inferred
  @@schema("dh")
}

enum OwnershipStatus {
