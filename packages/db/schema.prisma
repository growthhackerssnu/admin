// admin.ghsnu.com이 공유하는 Postgres의 물리 스키마 원본.
//
// 이 파일이 DB 구조의 유일한 소스다. 앱들(apps/*-backend/prisma/schema.prisma)은
// 각자 "내가 쓰는 테이블 목록"만 선언하는 생성 전용 사본이며 마이그레이션을 만들지
// 않는다. 규칙: docs/db/conventions.md §7
//
// 스키마 경계 (§2, §3):
//   core — 세 앱이 공유하는 신원·회원 데이터. 소유자는 portal.
//   dh   — 대협봇 업무 데이터. 소유자는 dh. 다른 앱은 접근하지 않는다.
//   hr   — 그핵드인 업무 데이터. Postgres에는 만들어져 있지만 아직 모델이 없어서
//          아래 schemas 배열에는 넣지 않았다. hr이 첫 테이블을 만들 때 추가한다.
//
// 설계 근거: docs/admin/integration/05_데이터 모델 제안.md (목업 기준 테이블 설계).
// 소싱·수집 파이프라인(sources/articles/funding_events 등)은 이번 범위 밖이다.
// DB 컬럼(snake_case)과 API DTO(camelCase)의 이름 차이는 각 앱의 serializer가 흡수한다.

// 이 패키지는 클라이언트를 쓰지 않는다 — 마이그레이션만 소유한다. generator 블록이
// 남아 있는 건 previewFeatures를 선언할 자리가 여기뿐이기 때문이고, 스크립트가
// --skip-generate로 실행해서 아래 output 디렉터리는 실제로 만들어지지 않는다.
// 앱이 쓰는 Prisma Client는 각 앱의 prisma/schema.prisma가 따로 생성한다.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "./generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["core", "dh"]
}

// ---------- Enums ----------

// admin: admin@ghsnu.com 고정, 전 영역 접근·편집·회원 승인/삭제.
// acting: 현재 액팅 회원. dh+hr 업무 권한 전부 동일(PM 서브권한 없음).
// alumni: 가입한 알럼나이. hr은 보기 전용, dh(대협봇)는 접근 자체 불가.
enum Role {
  admin
  acting
  alumni
  @@schema("core")
}

enum Channel {
  email
  linkedin
  @@schema("dh")
}

enum Route {
  new
  alternate_contact
  recontact
  repeat_collaboration
  @@schema("dh")
}

enum WorkStage {
  company_review
  recipient_selection
  draft_review
  ready_to_send
  response_check
  @@schema("dh")
}

// skipped_for_cycle은 차수 개념을 폐지하면서 쓰지 않는다. enum 값은 추가만 가능하고
// 삭제할 수 없어서(conventions §8) 자리만 남겨두고 skipped_for_quarter를 쓴다.
enum InternalDecision {
  active
  skipped_for_cycle
  excluded_permanently
  skipped_for_quarter
  @@schema("dh")
}

enum ResponseResult {
  no_reply
  discussing
  rejected
  deferred
  referred
  closed
  @@schema("dh")
}

enum ResponseCategory {
  resource_shortage
  not_interested
  no_problem_demand
  other
  @@schema("dh")
}

enum SendStatus {
  queued
  sending
  sent
  failed
  unknown
  @@schema("dh")
}

enum JobType {
  cycle_search
  contact_search
  draft_generate
  @@schema("dh")
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  @@schema("dh")
}

enum DraftOrigin {
  ai
  admin_edit
  @@schema("dh")
}

// ---------- 사용자 ----------

// 접근은 화이트리스트 방식이다. 관리자가 이메일로 행을 미리 만들어야 로그인이
// 완성된다(Google 인증 + 도메인 통과만으로는 접근이 열리지 않는다). 미리 만들
// 때는 supabaseUserId를 모르므로 nullable — 첫 로그인 때 연결한다.
model Member {
  id             String   @id @default(cuid())
  supabaseUserId String?  @unique @map("supabase_user_id")
  email          String   @unique
  displayName    String   @map("display_name")
  role           Role     @default(acting)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  lastLoginAt    DateTime? @map("last_login_at")

  createdQuarters     Quarter[]            @relation("QuarterCreatedBy")
  ownedOutreaches     Outreach[]           @relation("OutreachOwner")
  decidedOutreaches   Outreach[]           @relation("OutreachDecidedBy")
  checkedResponses    Response[]
  createdSearchRuns   SearchRun[]          @relation("SearchRunCreatedBy")
  fitDecisions        HumanFitDecision[]   @relation("FitDecisionDecidedBy")
  dhIdempotencyKeys   DhIdempotencyKey[]   @relation("DhIdempotencyActor")
  coreIdempotencyKeys CoreIdempotencyKey[] @relation("CoreIdempotencyActor")
  claimedPersonEntry  PeopleDirectory?

  @@map("members")
  @@schema("core")
}

// 노션 People DB(액팅+알럼나이 전체)에서 가져온 "신뢰 이메일" 원장
// (apps/portal-backend의 npm run people:import로 동기화). 딱 하나만 한다: 가입 신청 시 기수+이름으로
// 이 테이블을 찾아 knownEmail로 OTP를 보내서 "진짜 명단에 있는 사람"인지
// 확인한다. role(acting/alumni)은 여기서 판단하지 않는다 — 가입 직후엔 무조건
// alumni로 등록되고, admin이 나중에 개별로 acting으로 올린다.
// claimedByMemberId가 채워지면 이미 가입이 끝난 것 — 같은 항목으로 두 번
// 가입하는 걸 막는다.
model PeopleDirectory {
  id                String    @id @default(cuid())
  notionPageId      String    @unique @map("notion_page_id")
  cohort            String
  cohortNormalized  String    @map("cohort_normalized")
  name              String
  nameNormalized    String    @map("name_normalized")
  knownEmail        String    @map("known_email")
  claimedByMemberId String?   @unique @map("claimed_by_member_id")
  claimedBy         Member?   @relation(fields: [claimedByMemberId], references: [id])
  claimedAt         DateTime? @map("claimed_at")
  importedAt        DateTime  @default(now()) @map("imported_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  signupRequests SignupRequest[]

  @@index([cohortNormalized, nameNormalized])
  @@map("people_directory")
  @@schema("core")
}

enum SignupRequestStatus {
  pending
  verified
  expired
  @@schema("core")
}

// 기수+이름+원하는 구글 이메일로 가입 신청 → people_directory에서 대조한
// knownEmail로 OTP 발송 → 인증 성공 시 그 구글 이메일로 members 행 생성
// (role = alumni 고정, admin이 나중에 acting으로 승격).
model SignupRequest {
  id                String              @id @default(cuid())
  personDirectoryId String              @map("person_directory_id")
  personDirectory   PeopleDirectory     @relation(fields: [personDirectoryId], references: [id])
  desiredEmail      String              @map("desired_email")
  otpHash           String              @map("otp_hash")
  otpExpiresAt      DateTime            @map("otp_expires_at")
  attempts          Int                 @default(0)
  status            SignupRequestStatus @default(pending)
  createdAt         DateTime            @default(now()) @map("created_at")
  verifiedAt        DateTime?           @map("verified_at")

  @@map("signup_requests")
  @@schema("core")
}

// ---------- 분기 ----------

// 수주 분기. 라벨("2026-Q4")은 담당자가 직접 정한다 — 달력에서 자동으로 유도되는
// 값이 아니라서 행으로 관리한다. 닫으면 active=false가 되고 새 탐색에 못 쓴다.
//
// 전역 "현재 분기" 상태는 두지 않는다. 각 컨택 건·탐색이 자기 분기를 들고 있고,
// 서버는 "지금이 어느 분기다"를 따로 관리하지 않는다. 그래서 예전 차수 개념에
// 있던 활성 차수 충돌 검사(ACTIVE_CYCLE_CHANGED)도 없앴다.
model Quarter {
  id          String    @id @default(cuid())
  label       String    @unique
  active      Boolean   @default(true)
  createdById String    @map("created_by_id")
  createdBy   Member    @relation("QuarterCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  closedAt    DateTime? @map("closed_at")

  currentOutreaches  Outreach[]    @relation("OutreachQuarter")
  lastSentOutreaches Outreach[]    @relation("OutreachLastSentQuarter")
  skipOutreaches     Outreach[]    @relation("OutreachSkipQuarter")
  sentMessages       SentMessage[]
  searchRuns         SearchRun[]

  @@map("quarters")
  @@schema("dh")
}

// ---------- 기업 ----------

// 발견(리스트업)과 발송(컨택)이 공유하는 기업 식별 정보다. 컬럼 소유권을 나눠 쓴다:
//   발견 쪽 — name, legal_name, aliases, website_url, canonical_domain, created_at, updated_at
//   발송 쪽 — product, domain, permanently_excluded*, is_prelaunch_only, version
// 서로 상대 영역의 컬럼을 쓰지 않는다. product/domain은 발견 단계에서 채울 수 없어서
// nullable이다 — 발송 화면이 쓰던 값이라 비어 있을 수 있다는 뜻이다.
model Company {
  id                        String    @id @default(cuid())
  name                      String
  legalName                 String?   @map("legal_name")
  aliases                   String[]  @default([])
  websiteUrl                String?   @map("website_url")
  canonicalDomain           String?   @map("canonical_domain")
  product                   String?
  domain                    String?
  version                   Int       @default(1)
  permanentlyExcluded       Boolean   @default(false) @map("permanently_excluded")
  permanentlyExcludedReason String?   @map("permanently_excluded_reason")
  permanentlyExcludedAt     DateTime? @map("permanently_excluded_at")
  isPrelaunchOnly           Boolean   @default(false) @map("is_prelaunch_only")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  contacts           Contact[]
  contactEndpoints   ContactEndpoint[]
  prelaunchContacts  PrelaunchContact[]
  outreaches         Outreach[]
  pastProjects       PastProject[]
  evidence           Evidence[]
  researches         CompanyResearch[]
  candidates         Candidate[]
  persons            CompanyPerson[]
  contactChannels    ContactChannel[]

  @@index([canonicalDomain])
  @@map("companies")
  @@schema("dh")
}

model Contact {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  title        String?
  department   String?
  linkedinUrl  String?  @map("linkedin_url")
  createdAt    DateTime @default(now()) @map("created_at")

  endpoints             ContactEndpoint[]
  recipientOnOutreaches Outreach[]        @relation("OutreachRecipientContact")
  recipientOnSends      SentMessage[]     @relation("SentMessageRecipientContact")

  @@map("contacts")
  @@schema("dh")
}

model ContactEndpoint {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  company    Company  @relation(fields: [companyId], references: [id])
  contactId  String?  @map("contact_id")
  contact    Contact? @relation(fields: [contactId], references: [id])
  channel    Channel
  address    String
  valid      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  recipientOnOutreaches Outreach[]    @relation("OutreachRecipientEndpoint")
  recipientOnSends      SentMessage[] @relation("SentMessageRecipientEndpoint")

  @@map("contact_endpoints")
  @@schema("dh")
}

// 배포 전 이력만 있는 수신자를 제외 목적으로만 기록하는 최소 레코드.
// 정식 Contact 레코드가 없어도(엑셀 이관 등) 이름/이메일/링크드인으로 매칭해 후보에서 뺀다.
model PrelaunchContact {
  id           String  @id @default(cuid())
  companyId    String  @map("company_id")
  company      Company @relation(fields: [companyId], references: [id])
  name         String
  email        String?
  linkedinUrl  String? @map("linkedin_url")
  note         String?

  @@map("prelaunch_contacts")
  @@schema("dh")
}

// ---------- 컨택 건 ----------
// 기업당 진행 중인 건은 하나다(unique companyId). 분기가 바뀌어도 새 행을 만들지
// 않고 quarterId만 갱신한다 — 05_데이터 모델 제안.md에서 이미 확정.

model Outreach {
  id                    String            @id @default(cuid())
  companyId             String            @unique @map("company_id")
  company               Company           @relation(fields: [companyId], references: [id])
  ownerId               String            @map("owner_id")
  owner                 Member            @relation("OutreachOwner", fields: [ownerId], references: [id])
  quarterId             String            @map("quarter_id")
  quarter               Quarter           @relation("OutreachQuarter", fields: [quarterId], references: [id])

  route                 Route
  workStage             WorkStage         @map("work_stage")
  internalDecision      InternalDecision  @default(active) @map("internal_decision")
  version               Int               @default(1)

  recipientContactId    String?           @map("recipient_contact_id")
  recipientContact      Contact?          @relation("OutreachRecipientContact", fields: [recipientContactId], references: [id])
  recipientEndpointId   String?           @map("recipient_endpoint_id")
  recipientEndpoint     ContactEndpoint?  @relation("OutreachRecipientEndpoint", fields: [recipientEndpointId], references: [id])

  lastSentQuarterId     String?           @map("last_sent_quarter_id")
  lastSentQuarter       Quarter?          @relation("OutreachLastSentQuarter", fields: [lastSentQuarterId], references: [id])

  reviewNote            String?           @map("review_note")
  conditionEvidence     String?           @map("condition_evidence")
  reviewedAt            DateTime?         @map("reviewed_at")
  decidedById           String?           @map("decided_by_id")
  decidedBy             Member?           @relation("OutreachDecidedBy", fields: [decidedById], references: [id])
  decidedAt             DateTime?         @map("decided_at")

  skipNote              String?           @map("skip_note")
  skipQuarterId         String?           @map("skip_quarter_id")
  skipQuarter           Quarter?          @relation("OutreachSkipQuarter", fields: [skipQuarterId], references: [id])

  currentRevision       Int?              @map("current_revision")
  approvedRevision      Int?              @map("approved_revision")

  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  draftRevisions   MessageDraftRevision[]
  sentMessages     SentMessage[]
  responses        Response[]

  @@map("outreaches")
  @@schema("dh")
}

// ---------- 템플릿·초안 ----------

model Template {
  id              String   @id @default(cuid())
  route           Route
  channel         Channel
  version         Int
  subjectTemplate String   @map("subject_template")
  bodyTemplate    String   @map("body_template")
  active          Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  draftRevisions MessageDraftRevision[]
  sentMessages   SentMessage[]

  // route x channel 조합당 active = true는 하나만 허용 — 애플리케이션 레이어에서 강제
  // (부분 유니크 인덱스가 필요하면 마이그레이션에 raw SQL로 추가)
  @@map("templates")
  @@schema("dh")
}

// 초안은 수정할 때마다 새 리비전 행을 추가하는 append-only 이력이다.
// outreaches.currentRevision/approvedRevision이 "지금 보여줄 값"을 가리킨다.
model MessageDraftRevision {
  id              String      @id @default(cuid())
  outreachId      String      @map("outreach_id")
  outreach        Outreach    @relation(fields: [outreachId], references: [id])
  revision        Int
  topic           String
  subject         String
  body            String
  templateId      String?     @map("template_id")
  template        Template?   @relation(fields: [templateId], references: [id])
  templateVersion Int?        @map("template_version")
  createdBy       DraftOrigin @map("created_by")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@unique([outreachId, revision])
  @@map("message_draft_revisions")
  @@schema("dh")
}

// ---------- 발송·응답 ----------

model SentMessage {
  id                     String      @id @default(cuid())
  outreachId             String      @map("outreach_id")
  outreach               Outreach    @relation(fields: [outreachId], references: [id])
  quarterId              String      @map("quarter_id")
  quarter                Quarter     @relation(fields: [quarterId], references: [id])
  channel                Channel
  recipientContactId     String      @map("recipient_contact_id")
  recipientContact       Contact     @relation("SentMessageRecipientContact", fields: [recipientContactId], references: [id])
  recipientEndpointId    String      @map("recipient_endpoint_id")
  recipientEndpoint      ContactEndpoint @relation("SentMessageRecipientEndpoint", fields: [recipientEndpointId], references: [id])
  recipientNameSnapshot  String      @map("recipient_name_snapshot")
  addressSnapshot        String      @map("address_snapshot")
  subjectSnapshot        String      @map("subject_snapshot")
  bodySnapshot           String      @map("body_snapshot")
  templateId             String?     @map("template_id")
  template               Template?   @relation(fields: [templateId], references: [id])
  templateVersion        Int?        @map("template_version")
  status                 SendStatus  @default(sent)
  sentAt                 DateTime    @map("sent_at")
  createdAt              DateTime    @default(now()) @map("created_at")

  responses Response[]

  @@map("sent_messages")
  @@schema("dh")
}

// 응답 확인 결과. append-only — 같은 outreach에 여러 행이 쌓이고 최신 행이 현재 값이다.
model Response {
  id                String            @id @default(cuid())
  outreachId        String            @map("outreach_id")
  outreach          Outreach          @relation(fields: [outreachId], references: [id])
  sentMessageId     String?           @map("sent_message_id")
  sentMessage       SentMessage?      @relation(fields: [sentMessageId], references: [id])
  result            ResponseResult
  category          ResponseCategory?
  explanation       String?
  revisitCondition  String?           @map("revisit_condition")
  checkedById       String            @map("checked_by_id")
  checkedBy         Member            @relation(fields: [checkedById], references: [id])
  checkedAt         DateTime          @default(now()) @map("checked_at")

  @@map("responses")
  @@schema("dh")
}

// ---------- 과거 협업 ----------

model PastProject {
  id         String  @id @default(cuid())
  companyId  String  @map("company_id")
  company    Company @relation(fields: [companyId], references: [id])
  title      String
  summary    String?
  notionUrl  String? @map("notion_url")

  @@map("past_projects")
  @@schema("dh")
}

// ---------- 비동기 작업 ----------

model Job {
  id          String    @id @default(cuid())
  type        JobType
  status      JobStatus @default(queued)
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id")
  resultRef   Json?     @map("result_ref")
  error       String?
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("jobs")
  @@schema("dh")
}

// ---------- 멱등성 ----------

// POST/PUT/PATCH 변경 요청의 Idempotency-Key를 기록한다. 같은 키로 재시도가 오면
// 새 버전 검사보다 먼저 이 테이블을 조회해 이전에 성공한 응답을 그대로 재반환한다.
//
// 이건 공유 도메인 데이터가 아니라 각 앱의 내부 구현 디테일이라, 스키마마다 자기
// 테이블을 갖는다(conventions.md §4.1). 한 테이블을 공유하면 서로 다른 앱의 키가
// 한 네임스페이스에 섞여서, 우연히 같은 Idempotency-Key를 받으면 남의 응답을
// 돌려주거나 IDEMPOTENCY_CONFLICT가 난다.
//
// 물리 테이블 이름(idempotency_keys)은 같고 스키마만 다르다 — 이게 multiSchema의
// 용도다. 각 앱의 schema.prisma에는 자기 것 하나만 IdempotencyKey라는 이름으로
// 선언하므로, 앱 코드(src/lib/idempotency.ts)는 이 분리를 알 필요가 없다.

model DhIdempotencyKey {
  key             String   @id
  actorMemberId   String   @map("actor_member_id")
  actorMember     Member   @relation("DhIdempotencyActor", fields: [actorMemberId], references: [id])
  route           String
  requestHash     String   @map("request_hash")
  responseStatus  Int      @map("response_status")
  responseBody    Json     @map("response_body")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
  @@schema("dh")
}

model CoreIdempotencyKey {
  key             String   @id
  actorMemberId   String   @map("actor_member_id")
  actorMember     Member   @relation("CoreIdempotencyActor", fields: [actorMemberId], references: [id])
  route           String
  requestHash     String   @map("request_hash")
  responseStatus  Int      @map("response_status")
  responseBody    Json     @map("response_body")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
  @@schema("core")
}

// ---------- 리스트업(기업 발견·판단·연락처) ----------
//
// 리스트업_데이터스키마_API명세_v0.1.md의 논리 스키마를 물리 테이블로 옮긴 것이다.
// 명세의 workspace_id는 도입하지 않는다 — GH SNU 단일 조직이라 칸막이가 필요 없다.
//
// evidence 참조는 join 테이블 대신 String[]로 둔다. 구조가 같은 join 테이블이 다섯 개
// 생길 만한 값이 없고, 읽기는 항상 id 목록으로 한 번에 가져온다. evidence는 append-only라
// 끊긴 참조가 생기지 않으며, 참조 무결성은 앱이 보장한다(conventions.md §4에 기록).
//
// enum 타입 이름은 Postgres 스키마 안에서 전역 유일해야 한다. queued/running 같은 값은
// 기존 JobStatus·SendStatus에도 있어서, 새 enum은 전부 이름을 구분해서 붙였다.

enum SearchSourcePolicy {
  selected_only
  allow_supplementary
  @@schema("dh")
}

enum SearchRunStatus {
  queued
  running
  completed
  partially_completed
  failed
  cancelled
  @@schema("dh")
}

enum EvidenceSourceType {
  official
  company_database
  news
  newsletter
  linkedin
  other
  @@schema("dh")
}

enum ClaimCategory {
  product_service
  target_customer
  revenue_model
  user_journey
  operations
  recent_change
  public_challenge
  @@schema("dh")
}

enum ClaimBasis {
  reported_fact
  inference
  @@schema("dh")
}

enum FitVerdict {
  fit
  unfit
  pending
  @@schema("dh")
}

enum ContactStatus {
  not_started
  searching
  available
  needs_verification
  not_found
  @@schema("dh")
}

enum CriterionVerdict {
  supported
  unsupported
  unknown
  @@schema("dh")
}

enum ResolutionMethod {
  public_research
  company_confirmation
  @@schema("dh")
}

enum JobFunction {
  executive
  business_development
  product
  data
  other
  unknown
  @@schema("dh")
}

enum Seniority {
  c_level
  manager
  individual_contributor
  unknown
  @@schema("dh")
}

enum EmploymentStatus {
  current
  former
  unknown
  @@schema("dh")
}

enum ChannelOwnerType {
  person
  team
  company
  @@schema("dh")
}

enum DiscoveryMethod {
  public_source
  user_provided
  inferred
  @@schema("dh")
}

enum OwnershipStatus {
  supported
  uncertain
  contradicted
  @@schema("dh")
}

enum ValidationStatus {
  not_checked
  valid_format
  invalid
  @@schema("dh")
}

enum ReachabilityStatus {
  unknown
  confirmed
  unavailable
  @@schema("dh")
}

enum LinkedinMethod {
  connection_request
  direct_message
  inmail
  @@schema("dh")
}

enum CandidateContactStatus {
  usable
  needs_verification
  unusable
  @@schema("dh")
}

enum ContactPriority {
  preferred
  alternative
  @@schema("dh")
}

enum DecisionAuthority {
  supported
  unknown
  @@schema("dh")
}

enum ResearchTaskType {
  company_discovery
  company_research
  fit_assessment
  contact_research
  contact_verification
  @@schema("dh")
}

enum ResearchTaskTrigger {
  initial
  auto_followup
  human_request
  fit_changed
  @@schema("dh")
}

enum FollowupPolicy {
  automatic
  none
  @@schema("dh")
}

enum ResearchTaskStatus {
  queued
  running
  succeeded
  failed
  cancelled
  @@schema("dh")
}

// 탐색 실행. sources/filters/limits는 생성 후 바뀌지 않고 조인·필터 대상도 아니라서
// Json으로 둔다. duplicate_excluded_count는 화면의 "중복 N개 제외" 표시용이며
// 명세에는 없는 추가 필드다.
model SearchRun {
  id                     String             @id @default(cuid())
  quarterId              String             @map("quarter_id")
  quarter                Quarter            @relation(fields: [quarterId], references: [id])
  sourcePolicy           SearchSourcePolicy @map("source_policy")
  sources                Json
  filters                Json
  limits                 Json
  status                 SearchRunStatus    @default(queued)
  duplicateExcludedCount Int                @default(0) @map("duplicate_excluded_count")
  createdById            String             @map("created_by_id")
  createdBy              Member             @relation("SearchRunCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime           @default(now()) @map("created_at")
  startedAt              DateTime?          @map("started_at")
  finishedAt             DateTime?          @map("finished_at")

  candidates Candidate[]
  evidence   Evidence[]
  researches CompanyResearch[]
  tasks      ResearchTask[]

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([quarterId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("search_runs")
  @@schema("dh")
}

// 수집 근거. 수집 시점의 기록으로 보존하며 지우지 않는다. 같은 URL이라도 수집 시점과
// 발췌가 다르면 다른 행이다.
model Evidence {
  id          String             @id @default(cuid())
  companyId   String             @map("company_id")
  company     Company            @relation(fields: [companyId], references: [id])
  searchRunId String?            @map("search_run_id")
  searchRun   SearchRun?         @relation(fields: [searchRunId], references: [id])
  url         String
  sourceName  String             @map("source_name")
  sourceType  EvidenceSourceType @map("source_type")
  title       String?
  excerpt     String?
  publishedAt DateTime?          @map("published_at")
  retrievedAt DateTime           @default(now()) @map("retrieved_at")

  @@index([companyId, retrievedAt(sort: Desc)])
  @@map("evidence")
  @@schema("dh")
}

// 기업 조사의 한 버전. 새 조사는 새 행으로 쌓이고, 과거 판단은 당시 쓰던 버전을
// 계속 참조한다.
model CompanyResearch {
  id                 String    @id @default(cuid())
  companyId          String    @map("company_id")
  company            Company   @relation(fields: [companyId], references: [id])
  searchRunId        String    @map("search_run_id")
  searchRun          SearchRun @relation(fields: [searchRunId], references: [id])
  missingInformation String[]  @map("missing_information")
  createdAt          DateTime  @default(now()) @map("created_at")

  claims               ResearchClaim[]
  fitAssessments       FitAssessment[]
  currentForCandidates Candidate[]     @relation("CandidateCurrentResearch")

  @@index([companyId, createdAt(sort: Desc)])
  @@map("company_researches")
  @@schema("dh")
}

// 조사에서 나온 주장 하나. 명세가 claim마다 id를 주기 때문에 Json이 아니라 테이블이다.
// basis=reported_fact면 evidence_ids가 최소 하나 있어야 한다(앱이 검증).
model ResearchClaim {
  id          String          @id @default(cuid())
  researchId  String          @map("research_id")
  research    CompanyResearch @relation(fields: [researchId], references: [id])
  category    ClaimCategory
  content     String
  basis       ClaimBasis
  evidenceIds String[]        @map("evidence_ids")

  @@index([researchId])
  @@map("research_claims")
  @@schema("dh")
}

// 탐색별 기업 상태. effective_fit과 contact_status는 저장 컬럼이다 — 목록이 두 값을
// 동시에 필터하면서 커서 페이지네이션을 해야 해서 읽기 시점 계산으로는 안 된다.
// null인 effective_fit은 wire에서 "not_assessed"로 나간다.
model Candidate {
  id                            String            @id @default(cuid())
  searchRunId                   String            @map("search_run_id")
  searchRun                     SearchRun         @relation(fields: [searchRunId], references: [id])
  companyId                     String            @map("company_id")
  company                       Company           @relation(fields: [companyId], references: [id])
  discoveryEvidenceIds          String[]          @map("discovery_evidence_ids")
  currentResearchId             String?           @map("current_research_id")
  currentResearch               CompanyResearch?  @relation("CandidateCurrentResearch", fields: [currentResearchId], references: [id])
  latestSystemAssessmentId      String?           @map("latest_system_assessment_id")
  latestSystemAssessment        FitAssessment?    @relation("CandidateLatestAssessment", fields: [latestSystemAssessmentId], references: [id])
  activeHumanDecisionId         String?           @map("active_human_decision_id")
  activeHumanDecision           HumanFitDecision? @relation("CandidateActiveDecision", fields: [activeHumanDecisionId], references: [id])
  effectiveFit                  FitVerdict?       @map("effective_fit")
  contactStatus                 ContactStatus     @default(not_started) @map("contact_status")
  usableContactCount            Int               @default(0) @map("usable_contact_count")
  needsVerificationContactCount Int               @default(0) @map("needs_verification_contact_count")
  unusableContactCount          Int               @default(0) @map("unusable_contact_count")
  revision                      Int               @default(1)
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")

  fitAssessments    FitAssessment[]    @relation("CandidateAssessments")
  humanFitDecisions HumanFitDecision[] @relation("CandidateDecisions")
  contacts          CandidateContact[]
  tasks             ResearchTask[]

  @@unique([searchRunId, companyId])
  @@index([searchRunId, effectiveFit, contactStatus, createdAt(sort: Desc), id(sort: Desc)])
  @@index([searchRunId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([companyId])
  @@map("candidates")
  @@schema("dh")
}

// 시스템 판단 이력. 판단 지침이 바뀌어도 과거 행과 당시 criteria_version은 그대로 둔다.
model FitAssessment {
  id              String          @id @default(cuid())
  candidateId     String          @map("candidate_id")
  candidate       Candidate       @relation("CandidateAssessments", fields: [candidateId], references: [id])
  researchId      String          @map("research_id")
  research        CompanyResearch @relation(fields: [researchId], references: [id])
  verdict         FitVerdict
  summary         String
  informationGaps Json            @default("[]") @map("information_gaps")
  criteriaVersion String          @map("criteria_version")
  modelVersion    String?         @map("model_version")
  createdAt       DateTime        @default(now()) @map("created_at")

  interventions       InterventionAssessment[]
  latestForCandidates Candidate[]              @relation("CandidateLatestAssessment")
  basedOnDecisions    HumanFitDecision[]       @relation("DecisionBasedOnAssessment")

  @@index([candidateId, createdAt(sort: Desc)])
  @@map("fit_assessments")
  @@schema("dh")
}

// 개입 영역별 가능성·가치 평가. "같은 영역에서 둘 다 supported면 fit" 규칙을 DB에서
// 그대로 검사할 수 있도록 Json이 아니라 평탄한 테이블로 둔다.
model InterventionAssessment {
  id                     String           @id @default(cuid())
  assessmentId           String           @map("assessment_id")
  assessment             FitAssessment    @relation(fields: [assessmentId], references: [id])
  area                   String
  feasibilityVerdict     CriterionVerdict @map("feasibility_verdict")
  feasibilityRationale   String           @map("feasibility_rationale")
  feasibilityEvidenceIds String[]         @map("feasibility_evidence_ids")
  requiredConditions     String[]         @map("required_conditions")
  valueVerdict           CriterionVerdict @map("value_verdict")
  valueRationale         String           @map("value_rationale")
  valueEvidenceIds       String[]         @map("value_evidence_ids")
  targetBusinessOutcome  String           @map("target_business_outcome")

  @@index([assessmentId])
  @@map("intervention_assessments")
  @@schema("dh")
}

// 사람의 판단 이력. append-only이고 과거 행을 고치지 않는다. 시스템 재판단을
// 요구하지 않으며, 후보의 활성 판단 참조만 바뀐다.
model HumanFitDecision {
  id                  String         @id @default(cuid())
  candidateId         String         @map("candidate_id")
  candidate           Candidate      @relation("CandidateDecisions", fields: [candidateId], references: [id])
  verdict             FitVerdict
  reason              String?
  interventionNote    String?        @map("intervention_note")
  basedOnAssessmentId String?        @map("based_on_assessment_id")
  basedOnAssessment   FitAssessment? @relation("DecisionBasedOnAssessment", fields: [basedOnAssessmentId], references: [id])
  decidedById         String         @map("decided_by_id")
  decidedBy           Member         @relation("FitDecisionDecidedBy", fields: [decidedById], references: [id])
  createdAt           DateTime       @default(now()) @map("created_at")

  activeForCandidates Candidate[] @relation("CandidateActiveDecision")

  @@index([candidateId, createdAt(sort: Desc)])
  @@map("human_fit_decisions")
  @@schema("dh")
}

// 기업 관계자. 직무·직급은 우선순위 판단에 쓰고 연락 가능성의 필수 조건은 아니다.
model CompanyPerson {
  id                    String           @id @default(cuid())
  companyId             String           @map("company_id")
  company               Company          @relation(fields: [companyId], references: [id])
  name                  String
  jobTitle              String?          @map("job_title")
  jobFunction           JobFunction      @default(unknown) @map("job_function")
  seniority             Seniority        @default(unknown)
  employmentStatus      EmploymentStatus @default(unknown) @map("employment_status")
  employmentEvidenceIds String[]         @map("employment_evidence_ids")
  checkedAt             DateTime         @default(now()) @map("checked_at")

  contactChannels ContactChannel[]

  @@index([companyId])
  @@map("company_persons")
  @@schema("dh")
}

// 연락 창구. (company, type, value) 유일 제약은 작업 재시도가 같은 창구를 두 번 만들지
// 않게 하는 안전장치다(명세 §6.8). 프로필을 찾은 것과 실제 도달 확인은 다른 값이라
// 소유·형식·도달을 각각 따로 기록한다.
model ContactChannel {
  id                 String             @id @default(cuid())
  companyId          String             @map("company_id")
  company            Company            @relation(fields: [companyId], references: [id])
  personId           String?            @map("person_id")
  person             CompanyPerson?     @relation(fields: [personId], references: [id])
  type               Channel
  value              String
  ownerType          ChannelOwnerType   @map("owner_type")
  discoveryMethod    DiscoveryMethod    @map("discovery_method")
  ownershipStatus    OwnershipStatus    @map("ownership_status")
  validationStatus   ValidationStatus   @default(not_checked) @map("validation_status")
  reachabilityStatus ReachabilityStatus @default(unknown) @map("reachability_status")
  linkedinMethods    LinkedinMethod[]   @map("linkedin_methods")
  evidenceIds        String[]           @map("evidence_ids")
  checkedAt          DateTime           @default(now()) @map("checked_at")

  candidateContacts CandidateContact[]

  @@unique([companyId, type, value])
  @@index([companyId])
  @@map("contact_channels")
  @@schema("dh")
}

// 후보별 창구 평가. usable은 소유가 뒷받침되고 형식이 유효하며 알려진 사용 불가
// 사유가 없다는 뜻이고, 실제 수신을 보장하지 않는다.
model CandidateContact {
  id                String                 @id @default(cuid())
  candidateId       String                 @map("candidate_id")
  candidate         Candidate              @relation(fields: [candidateId], references: [id])
  contactChannelId  String                 @map("contact_channel_id")
  contactChannel    ContactChannel         @relation(fields: [contactChannelId], references: [id])
  status            CandidateContactStatus
  priority          ContactPriority        @default(alternative)
  roleRelevance     String?                @map("role_relevance")
  decisionAuthority DecisionAuthority      @default(unknown) @map("decision_authority")
  reason            String
  checkedAt         DateTime               @default(now()) @map("checked_at")

  @@unique([candidateId, contactChannelId])
  @@index([candidateId, priority, checkedAt(sort: Desc), id(sort: Desc)])
  @@map("candidate_contacts")
  @@schema("dh")
}

// 비동기 조사 작업. error를 Json이 아니라 세 컬럼으로 펴둔 이유는 재시도가
// status=failed AND retryable=true로 걸러야 하고, 연락 상태 계산도 활성 작업을
// 인덱스로 찾아야 하기 때문이다.
model ResearchTask {
  id                   String              @id @default(cuid())
  searchRunId          String              @map("search_run_id")
  searchRun            SearchRun           @relation(fields: [searchRunId], references: [id])
  candidateId          String?             @map("candidate_id")
  candidate            Candidate?          @relation(fields: [candidateId], references: [id])
  parentTaskId         String?             @map("parent_task_id")
  parentTask           ResearchTask?       @relation("ResearchTaskChildren", fields: [parentTaskId], references: [id])
  type                 ResearchTaskType
  trigger              ResearchTaskTrigger
  requestedInformation String[]            @map("requested_information")
  followupPolicy       FollowupPolicy      @map("followup_policy")
  status               ResearchTaskStatus  @default(queued)
  attempt              Int                 @default(1)
  resultRefs           Json                @default("[]") @map("result_refs")
  errorCode            String?             @map("error_code")
  errorMessage         String?             @map("error_message")
  errorRetryable       Boolean?            @map("error_retryable")
  createdAt            DateTime            @default(now()) @map("created_at")
  startedAt            DateTime?           @map("started_at")
  finishedAt           DateTime?           @map("finished_at")

  childTasks ResearchTask[] @relation("ResearchTaskChildren")

  @@index([candidateId, type, status])
  @@index([searchRunId, status])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("research_tasks")
  @@schema("dh")
}
