// 구 worker가 신규 사람 검토 작업을 가져가지 않도록 실행 경로를 분리한다.
enum ResearchPipeline {
  legacy
  human_review
  @@schema("dh")
}

enum CollectionSourceKind {
  web_archive
  gmail
  public_api
  @@schema("dh")
}

enum CollectionItemStatus {
  pending
  processing
  completed
  failed
  @@schema("dh")
}

enum CollectedCompanyResult {
  created
  duplicate
  error
  @@schema("dh")
}

enum CandidateResearchStatus {
  queued
  running
  ready
  error
  @@schema("dh")
}

enum CandidateReviewStatus {
  unreviewed
  reviewing
  approved
  rejected_fit
  rejected_contact
  @@schema("dh")
}

enum CandidateReviewAction {
  approve
  reject_fit
  reject_contact
  reopen
  @@schema("dh")
}

enum HumanReviewFit {
  fit
  unfit
  @@schema("dh")
}

enum ContactCheckResult {
  confirmed
  not_found
  unchecked
  @@schema("dh")
}

// 수집원 설정. 인증 비밀은 config에 넣지 않고 서버 환경에서 읽는다.
model CollectionSource {
  id            String               @id @default(cuid())
  kind          CollectionSourceKind
  key           String               @unique
  name          String
  enabled       Boolean              @default(true)
  config        Json
  parserVersion String               @map("parser_version")

  searchRuns SearchRun[]
  items      CollectionItem[]
  nameKeys   CompanyNameKey[]

  @@map("collection_sources")
  @@schema("dh")
}

// 전체 수집 유입 스위치. id="dh" 한 행만 사용하며 개별 CollectionSource.enabled와 별개다.
model CollectionIntakeControl {
  id          String   @id
  paused      Boolean  @default(false)
  version     Int      @default(1)
  changedById String?  @map("changed_by_id")
  changedBy   Member?  @relation("CollectionIntakeChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime @default(now()) @map("changed_at")

  @@map("collection_intake_controls")
  @@schema("dh")
}

// 웹 아카이브 글 하나 또는 향후 이메일 한 통. source+externalKey가 재실행 키다.
model CollectionItem {
  id            String               @id @default(cuid())
  sourceId      String               @map("source_id")
  source        CollectionSource     @relation(fields: [sourceId], references: [id])
  firstRunId    String               @map("first_run_id")
  firstRun      SearchRun            @relation(fields: [firstRunId], references: [id])
  externalKey   String               @map("external_key")
  url           String?
  title         String?
  publishedAt   DateTime?            @map("published_at")
  contentHash   String?              @map("content_hash")
  parserVersion String               @map("parser_version")
  status        CollectionItemStatus @default(pending)
  attempt       Int                  @default(0)
  leaseToken    String?              @map("lease_token")
  leaseUntil    DateTime?            @map("lease_until")
  errorCode     String?              @map("error_code")
  errorMessage  String?              @map("error_message")
  retryable     Boolean?
  extractedAt   DateTime?            @map("extracted_at")

  companies CollectedCompany[]

  @@unique([sourceId, externalKey])
  @@index([status, leaseUntil])
  @@index([firstRunId])
  @@map("collection_items")
  @@schema("dh")
}

// 원문에서 본 기업 이름과 한 줄 설명. 중복이어도 추출 사실은 남긴다.
model CollectedCompany {
  id             String                 @id @default(cuid())
  itemId         String                 @map("item_id")
  item           CollectionItem         @relation(fields: [itemId], references: [id])
  name           String
  normalizedName String                 @map("normalized_name")
  summary        String
  companyId      String?                @map("company_id")
  company        Company?               @relation(fields: [companyId], references: [id])
  candidateId    String?                @map("candidate_id")
  candidate      Candidate?             @relation("CollectedCompanyCandidate", fields: [candidateId], references: [id])
  result         CollectedCompanyResult
  errorCode      String?                @map("error_code")

  originForCandidate Candidate? @relation("CandidateOriginCollectedCompany")

  @@unique([itemId, normalizedName])
  @@index([companyId])
  @@index([candidateId])
  @@map("collected_companies")
  @@schema("dh")
}

// 같은 소스에서 재등장한 이름을 이미 저장한 기업에 연결하는 키.
model CompanyNameKey {
  id             String           @id @default(cuid())
  sourceId       String           @map("source_id")
  source         CollectionSource @relation(fields: [sourceId], references: [id])
  normalizedName String           @map("normalized_name")
  companyId      String           @map("company_id")
  company        Company          @relation(fields: [companyId], references: [id])
  createdAt      DateTime         @default(now()) @map("created_at")

  @@unique([sourceId, normalizedName])
  @@index([companyId])
  @@map("company_name_keys")
  @@schema("dh")
}

// 탐색 배치.
//
// conditionsSnapshot은 생성 당시의 업무 입력(sources·filters)과 **실제 실행 설정**을
// 함께 얼려둔다(v0.4 §6.4). 실행 설정을 서버 config에서 읽어 여기에 복사하는 이유는,
// 나중에 config를 바꿔도 과거 배치가 "어떤 상한으로 돌았는지"가 남아야 하기 때문이다.
// API 읽기 모델은 이 스냅샷에서 sources·filters를 펼쳐 제공한다.
//
// 실행 설정의 뜻(2026-09-26 확정)은 src/config/listupExecution.ts에 적혀 있다. 요약하면
// maxCompanies는 조사 상한이지 확보 목표가 아니고, 발견·정보 보완·연락 조사 세 루프가
// 각자 3회에서 멈춘다. 기술적 재시도는 이 횟수와 별개다.
//
// 담당자(assignedMember)는 실행 책임자이고 AI 판단의 승인자가 아니다(P-02).
// duplicateExcludedCount는 화면의 "중복 N개 제외" 표시용이다.
model SearchRun {
  id                     String             @id @default(cuid())
  sourceId               String?            @map("source_id")
  source                 CollectionSource?  @relation(fields: [sourceId], references: [id])
  scheduledFor           DateTime?          @map("scheduled_for")
  targetQuarterId        String?            @map("target_quarter_id")
  targetQuarter          TargetQuarter?     @relation(fields: [targetQuarterId], references: [id])
  conditionsSnapshot     Json               @map("conditions_snapshot")
  status                 SearchRunStatus    @default(queued)
  duplicateExcludedCount Int                @default(0) @map("duplicate_excluded_count")
  finishReason           String?            @map("finish_reason")
  assignedMemberId       String?            @map("assigned_member_id")
  assignedMember         Member?            @relation("SearchRunAssignee", fields: [assignedMemberId], references: [id])
  createdById            String?            @map("created_by_id")
  createdBy              Member?            @relation("SearchRunCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime           @default(now()) @map("created_at")
  startedAt              DateTime?          @map("started_at")
  finishedAt             DateTime?          @map("finished_at")

  candidates Candidate[]
  evidence   Evidence[]
  researches CompanyResearch[]
  tasks      ResearchTask[]
  outreaches Outreach[]
  collectionItems CollectionItem[]

  @@unique([sourceId, scheduledFor])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([targetQuarterId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("search_runs")
  @@schema("dh")
}

// 수집 근거. 수집 시점의 기록으로 보존하며 지우지 않는다. 같은 URL이라도 수집 시점과
// 발췌가 다르면 다른 행이다.
model Evidence {
  id          String             @id @default(cuid())
  companyId   String             @map("company_id")
  company     Company            @relation(fields: [companyId], references: [id])
  searchRunId String?            @map("search_run_id")
  searchRun   SearchRun?         @relation(fields: [searchRunId], references: [id])
  url         String
  sourceKey   String             @map("source_key")
  title       String?
  excerpt     String?
  publishedAt DateTime?          @map("published_at")
  retrievedAt DateTime           @default(now()) @map("retrieved_at")

  @@index([companyId, retrievedAt(sort: Desc)])
  @@map("evidence")
  @@schema("dh")
}

// 기업 조사의 한 버전. 새 조사는 새 행으로 쌓이고, 과거 판단은 당시 쓰던 버전을
// 계속 참조한다.
model CompanyResearch {
  id                 String    @id @default(cuid())
  companyId          String    @map("company_id")
  company            Company   @relation(fields: [companyId], references: [id])
  originSearchRunId  String?   @map("origin_search_run_id")
  originSearchRun    SearchRun? @relation(fields: [originSearchRunId], references: [id])
  taskId             String?   @map("task_id")
  missingInformation String[]  @map("missing_information")
  createdAt          DateTime  @default(now()) @map("created_at")

  claims               ResearchClaim[]
  fitAssessments       FitAssessment[]
  currentForCandidates Candidate[]     @relation("CandidateCurrentResearch")
  reviewDecisions      CandidateReviewDecision[]
  draftRevisions       MessageDraftRevision[]

  @@index([companyId, createdAt(sort: Desc)])
  @@map("company_researches")
  @@schema("dh")
}

// 조사에서 나온 주장 하나. 명세가 claim마다 id를 주기 때문에 Json이 아니라 테이블이다.
// basis=reported_fact면 evidence_ids가 최소 하나 있어야 한다(앱이 검증).
model ResearchClaim {
  id          String          @id @default(cuid())
  researchId  String          @map("research_id")
  research    CompanyResearch @relation(fields: [researchId], references: [id])
  category    ClaimCategory
  content     String
  basis       ClaimBasis
  evidenceIds String[]        @map("evidence_ids")

  @@index([researchId])
  @@map("research_claims")
  @@schema("dh")
}

// 탐색별 기업 상태. effective_fit과 contact_status는 저장 컬럼이다 — 목록이 두 값을
// 동시에 필터하면서 커서 페이지네이션을 해야 해서 읽기 시점 계산으로는 안 된다.
// null인 effective_fit은 wire에서 "not_assessed"로 나간다.
model Candidate {
  id                            String            @id @default(cuid())
  originCollectedCompanyId      String?           @unique @map("origin_collected_company_id")
  originCollectedCompany        CollectedCompany? @relation("CandidateOriginCollectedCompany", fields: [originCollectedCompanyId], references: [id])
  researchStatus                CandidateResearchStatus? @map("research_status")
  reviewStatus                  CandidateReviewStatus? @map("review_status")
  reviewOwnerId                 String?           @map("review_owner_id")
  reviewOwner                   Member?           @relation("CandidateReviewOwner", fields: [reviewOwnerId], references: [id])
  selectedContactId             String?           @map("selected_contact_id")
  selectedContact               Contact?          @relation("CandidateSelectedContact", fields: [selectedContactId], references: [id])
  selectedEndpointId            String?           @map("selected_endpoint_id")
  selectedEndpoint              ContactEndpoint?  @relation("CandidateSelectedEndpoint", fields: [selectedEndpointId], references: [id])
  activeReviewDecisionId        String?           @unique @map("active_review_decision_id")
  activeReviewDecision          CandidateReviewDecision? @relation("CandidateActiveReviewDecision", fields: [activeReviewDecisionId], references: [id])
  originSearchRunId             String?           @map("origin_search_run_id")
  originSearchRun               SearchRun?        @relation(fields: [originSearchRunId], references: [id])
  companyId                     String            @map("company_id")
  company                       Company           @relation(fields: [companyId], references: [id])
  discoveryEvidenceIds          String[]          @map("discovery_evidence_ids")
  currentResearchId             String?           @map("current_research_id")
  currentResearch               CompanyResearch?  @relation("CandidateCurrentResearch", fields: [currentResearchId], references: [id])
  latestSystemAssessmentId      String?           @map("latest_system_assessment_id")
  latestSystemAssessment        FitAssessment?    @relation("CandidateLatestAssessment", fields: [latestSystemAssessmentId], references: [id])
  activeHumanDecisionId         String?           @map("active_human_decision_id")
  activeHumanDecision           HumanFitDecision? @relation("CandidateActiveDecision", fields: [activeHumanDecisionId], references: [id])
  effectiveFit                  FitVerdict?       @map("effective_fit")
  contactResearchStatus         ContactStatus     @default(not_started) @map("contact_research_status")
  usableContactCount            Int               @default(0) @map("usable_contact_count")
  needsVerificationContactCount Int               @default(0) @map("needs_verification_contact_count")
  unusableContactCount          Int               @default(0) @map("unusable_contact_count")
  revision                      Int               @default(1)
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")

  fitAssessments    FitAssessment[]    @relation("CandidateAssessments")
  humanFitDecisions HumanFitDecision[] @relation("CandidateDecisions")
  contactOptions    ContactOptionAssessment[]
  tasks             ResearchTask[]
  matchedCollectedCompanies CollectedCompany[] @relation("CollectedCompanyCandidate")
  reviewDecisions CandidateReviewDecision[] @relation("CandidateReviewHistory")
  reviewAssignmentItem ReviewAssignmentItem?
  outreaches Outreach[]

  @@unique([companyId])
  @@index([originSearchRunId, effectiveFit, contactResearchStatus, createdAt(sort: Desc), id(sort: Desc)])
  @@index([originSearchRunId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([companyId])
  @@index([researchStatus, reviewStatus, reviewOwnerId, createdAt, id])
  @@map("candidates")
  @@schema("dh")
}

// 팀장이 현재 배정 가능 큐에서 확정한 고정 회차. 날짜는 작업 계획이며 자동 상태 전이는 없다.
model ReviewAssignmentBatch {
  id                      String   @id @default(cuid())
  workStartsOn            DateTime @db.Date @map("work_starts_on")
  workEndsOn              DateTime @db.Date @map("work_ends_on")
  snapshotAt              DateTime @map("snapshot_at")
  eligibleCountAtSnapshot Int      @map("eligible_count_at_snapshot")
  perMemberCount          Int      @map("per_member_count")
  selectedMemberCount     Int      @map("selected_member_count")
  createdById             String   @map("created_by_id")
  createdBy               Member   @relation("ReviewAssignmentBatchCreator", fields: [createdById], references: [id])
  createdAt               DateTime @default(now()) @map("created_at")

  items ReviewAssignmentItem[]

  @@index([createdAt(sort: Desc)])
  @@map("review_assignment_batches")
  @@schema("dh")
}

// 회차의 기업·담당자 스냅샷. 빠르게 완료해도 자동 보충하지 않는다.
model ReviewAssignmentItem {
  id         String   @id @default(cuid())
  batchId    String   @map("batch_id")
  batch      ReviewAssignmentBatch @relation(fields: [batchId], references: [id])
  candidateId String  @unique @map("candidate_id")
  candidate  Candidate @relation(fields: [candidateId], references: [id])
  memberId   String   @map("member_id")
  member     Member   @relation("ReviewAssignmentItemMember", fields: [memberId], references: [id])
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@index([batchId, memberId])
  @@index([memberId, assignedAt(sort: Desc)])
  @@map("review_assignment_items")
  @@schema("dh")
}

// 사람 판단은 이전 결정을 덮어쓰지 않고 이어서 남긴다.
model CandidateReviewDecision {
  id            String              @id @default(cuid())
  candidateId   String              @map("candidate_id")
  candidate     Candidate           @relation("CandidateReviewHistory", fields: [candidateId], references: [id])
  action        CandidateReviewAction
  fit           HumanReviewFit?
  contactResult ContactCheckResult  @map("contact_result")
  researchId    String              @map("research_id")
  research      CompanyResearch     @relation(fields: [researchId], references: [id])
  contactId     String?             @map("contact_id")
  contact       Contact?            @relation("CandidateDecisionContact", fields: [contactId], references: [id])
  endpointId    String?             @map("endpoint_id")
  endpoint      ContactEndpoint?    @relation("CandidateDecisionEndpoint", fields: [endpointId], references: [id])
  note          String?
  decidedById   String              @map("decided_by_id")
  decidedBy     Member              @relation("CandidateReviewDecider", fields: [decidedById], references: [id])
  createdAt     DateTime            @default(now()) @map("created_at")

  activeForCandidate Candidate? @relation("CandidateActiveReviewDecision")
  draftRevisions MessageDraftRevision[]

  @@index([candidateId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("candidate_review_decisions")
  @@schema("dh")
}

// 시스템 판단 이력. 판단 지침이 바뀌어도 과거 행과 당시 criteria_version은 그대로 둔다.
model FitAssessment {
  id              String          @id @default(cuid())
  candidateId     String          @map("candidate_id")
  candidate       Candidate       @relation("CandidateAssessments", fields: [candidateId], references: [id])
  researchId      String          @map("research_id")
  research        CompanyResearch @relation(fields: [researchId], references: [id])
  verdict         FitVerdict
  summary         String
  informationGaps String[]        @default([]) @map("information_gaps")
  criteriaVersion String          @map("criteria_version")
  modelVersion    String?         @map("model_version")
  createdAt       DateTime        @default(now()) @map("created_at")

  interventions       InterventionAssessment[]
  latestForCandidates Candidate[]              @relation("CandidateLatestAssessment")
  basedOnDecisions    HumanFitDecision[]       @relation("DecisionBasedOnAssessment")

  @@index([candidateId, createdAt(sort: Desc)])
  @@map("fit_assessments")
  @@schema("dh")
}

// 개입 영역별 가능성·가치 평가. "같은 영역에서 둘 다 supported면 fit" 규칙을 DB에서
// 그대로 검사할 수 있도록 Json이 아니라 평탄한 테이블로 둔다.
model InterventionAssessment {
  id                     String           @id @default(cuid())
  assessmentId           String           @map("assessment_id")
  assessment             FitAssessment    @relation(fields: [assessmentId], references: [id])
  area                   String
  possibilityVerdict     CriterionVerdict @map("possibility_verdict")
  possibilityReason      String           @map("possibility_reason")
  possibilityEvidenceIds String[]         @map("possibility_evidence_ids")
  prerequisites          String[]         @map("prerequisites")
  valueVerdict           CriterionVerdict @map("value_verdict")
  valueReason            String           @map("value_reason")
  valueEvidenceIds       String[]         @map("value_evidence_ids")
  targetBusinessOutcome  String           @map("target_business_outcome")

  @@index([assessmentId])
  @@map("intervention_assessments")
  @@schema("dh")
}

// 사람의 판단 이력. append-only이고 과거 행을 고치지 않는다. 시스템 재판단을
// 요구하지 않으며, 후보의 활성 판단 참조만 바뀐다.
model HumanFitDecision {
  id                  String         @id @default(cuid())
  candidateId         String         @map("candidate_id")
  candidate           Candidate      @relation("CandidateDecisions", fields: [candidateId], references: [id])
  verdict             FitVerdict
  reason              String?
  interventionNote    String?        @map("intervention_note")
  basedOnAssessmentId String?        @map("based_on_assessment_id")
  basedOnAssessment   FitAssessment? @relation("DecisionBasedOnAssessment", fields: [basedOnAssessmentId], references: [id])
  decidedById         String         @map("decided_by_id")
  decidedBy           Member         @relation("FitDecisionDecidedBy", fields: [decidedById], references: [id])
  createdAt           DateTime       @default(now()) @map("created_at")

  activeForCandidates Candidate[] @relation("CandidateActiveDecision")

  @@index([candidateId, createdAt(sort: Desc)])
  @@map("human_fit_decisions")
  @@schema("dh")
}

// 후보별 연락 선택지 평가. 관계자·연락 수단 자체는 기존 contacts/contact_endpoints에
// 있고(§8.4), 여기에는 "이 조사 건에서 이 창구를 쓸 수 있는가"만 남긴다.
//
// usable은 조사 또는 사람의 확인상 쓸 수 있다는 평가이고 실제 수신·답장을 보장하지
// 않는다. 자동 채널 선택(preferred/alternative)은 두지 않는다 — 수신자와 채널은
// 사람이 고른다(P-09). 사람이 직접 확인해 등록한 창구는 confirmedBy와 확인 근거를
// 남기고 즉시 usable이 될 수 있다(P-19). 조사가 만든 평가는 confirmedBy=null이다.
model ContactOptionAssessment {
  id                String                 @id @default(cuid())
  candidateId       String                 @map("candidate_id")
  candidate         Candidate              @relation(fields: [candidateId], references: [id])
  endpointId        String                 @map("endpoint_id")
  endpoint          ContactEndpoint        @relation(fields: [endpointId], references: [id])
  status            CandidateContactStatus
  roleRelevance     String?                @map("role_relevance")
  decisionAuthority DecisionAuthority      @default(unknown) @map("decision_authority")
  reason            String?
  sourceUrl         String?                @map("source_url")
  confirmedById     String?                @map("confirmed_by_id")
  confirmedBy       Member?                @relation("ContactConfirmedBy", fields: [confirmedById], references: [id])
  checkedAt         DateTime               @default(now()) @map("checked_at")

  @@unique([candidateId, endpointId])
  @@index([candidateId, status, checkedAt(sort: Desc), id(sort: Desc)])
  @@map("contact_option_assessments")
  @@schema("dh")
}

// 비동기 조사 작업. error를 Json이 아니라 세 컬럼으로 펴둔 이유는 재시도가
// status=failed AND retryable=true로 걸러야 하고, 연락 상태 계산도 활성 작업을
// 인덱스로 찾아야 하기 때문이다.
model ResearchTask {
  id                   String              @id @default(cuid())
  searchRunId          String?             @map("search_run_id")
  searchRun            SearchRun?          @relation(fields: [searchRunId], references: [id])
  jobId                String?             @map("job_id")
  candidateId          String?             @map("candidate_id")
  candidate            Candidate?          @relation(fields: [candidateId], references: [id])
  parentTaskId         String?             @map("parent_task_id")
  parentTask           ResearchTask?       @relation("ResearchTaskChildren", fields: [parentTaskId], references: [id])
  type                 ResearchTaskType
  pipeline             ResearchPipeline    @default(legacy)
  trigger              ResearchTaskTrigger
  requestedInformation String[]            @map("requested_information")
  followupPolicy       FollowupPolicy?     @map("followup_policy")
  status               ResearchTaskStatus  @default(queued)
  attempt              Int                 @default(1)
  resultRefs           Json                @default("[]") @map("result_refs")
  errorCode            String?             @map("error_code")
  errorMessage         String?             @map("error_message")
  errorRetryable       Boolean?            @map("error_retryable")
  leaseToken           String?             @map("lease_token")
  leaseUntil           DateTime?           @map("lease_until")
  createdAt            DateTime            @default(now()) @map("created_at")
  startedAt            DateTime?           @map("started_at")
  finishedAt           DateTime?           @map("finished_at")

  childTasks ResearchTask[] @relation("ResearchTaskChildren")

  @@index([candidateId, type, status])
  @@index([pipeline, type, status, createdAt(sort: Desc)])
  @@index([searchRunId, status])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("research_tasks")
  @@schema("dh")
}

// ---------- NUT 재무 ----------

enum NutBucketKind {
  income
  expense
  tax
  @@schema("nut")
}

enum NutTaxClass {
  non_taxable_gain
  taxable_gain
  tax_deductible_expense
  non_tax_deductible_expense
  tax
  @@schema("nut")
}

enum NutBucketLevel {
  major
  middle
  minor
  @@schema("nut")
}

enum NutLedgerType {
  income
  expense
  @@schema("nut")
}

enum NutAccountingScope {
  project
  team
  @@schema("nut")
}

enum NutAccountingCategory {
  support
  technical
  @@schema("nut")
}

enum NutClaimStatus {
  review
  approved
  paid
  rejected
  @@schema("nut")
}

model NutFinancePeriod {
  id             String   @id
  label          String
  // 이 반기 운영팀의 기수(2026-2 = 19기). 설정 이름의 {senior}기·{junior}기가 이 값으로 바뀐다.
  operatingCohort Int     @map("operating_cohort")
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  asOf           DateTime @map("as_of") @db.Date
  fiscalYearLabel String  @map("fiscal_year_label")
  fiscalYearStart DateTime @map("fiscal_year_start") @db.Date
  fiscalYearEnd  DateTime @map("fiscal_year_end") @db.Date
  openingCash    BigInt   @default(0) @map("opening_cash")
  currentCash    BigInt   @default(0) @map("current_cash")
  incomeBudget   BigInt   @default(0) @map("income_budget")
  incomeActual   BigInt   @default(0) @map("income_actual")
  expenseBudget  BigInt   @default(0) @map("expense_budget")
  expenseActual  BigInt   @default(0) @map("expense_actual")

  @@map("finance_periods")
  @@schema("nut")
}

model NutFinanceBucket {
  id          String   @id
  name        String
  parentId    String?  @map("parent_id")
  kind        NutBucketKind
  taxClass    NutTaxClass @map("tax_class")
  budget      BigInt   @default(0)
  spent       BigInt   @default(0)
  description String?

  @@map("finance_buckets")
  @@schema("nut")
}

model NutBudgetNode {
  id         String         @id
  periodId   String         @map("period_id")
  name       String
  parentId   String?        @map("parent_id")
  level      NutBucketLevel
  kind       NutBucketKind
  taxClass   NutTaxClass    @map("tax_class")
  budget     BigInt         @default(0)
  spent      BigInt         @default(0)
  sortOrder  Int            @map("sort_order")
  formula    String?
  formulaKey String?        @map("formula_key")
  formulaExpression String? @map("formula_expression")
  note       String?
  active     Boolean        @default(true)
  // 언제 내는 돈인지: every(매 반기), spring(봄·여름 반기만), fall(가을·겨울 반기만), once(이번 반기만 — 새 반기로 복사하지 않는다).
  billing    String         @default("every")

  @@index([periodId, parentId, sortOrder])
  @@map("budget_nodes")
  @@schema("nut")
}

// id는 산출식의 변수명이라 반기마다 같은 이름(cohort-19 등)을 다시 쓴다 → (반기, id) 복합키.
model NutBudgetParameter {
  periodId    String   @map("period_id")
  id          String
  label       String
  // 달러 단가($8.75)·개월 수(4.5)가 있어서 실수다.
  value       Float
  unit        String
  description String
  // 설정 화면의 묶음(인원·프로젝트·지원 단가·구독·환율)과 그 안의 순서.
  category    String   @default("기타")
  sortOrder   Int      @default(0) @map("sort_order")

  @@id([periodId, id])
  @@map("budget_parameters")
  @@schema("nut")
}

model NutIncomeLine {
  id        String      @id
  periodId  String      @map("period_id")
  name      String
  budget    BigInt      @default(0)
  actual    BigInt      @default(0)
  sortOrder Int         @map("sort_order")
  note      String?
  taxClass  NutTaxClass @map("tax_class")

  @@index([periodId, sortOrder])
  @@map("income_lines")
  @@schema("nut")
}

model NutMonthlyFlow {
  id       String   @id
  periodId String   @map("period_id")
  month    String
  label    String
  budget   BigInt  @default(0)
  actual   BigInt  @default(0)
  income   BigInt  @default(0)

  @@index([periodId, month])
  @@map("monthly_flows")
  @@schema("nut")
}

model NutLedgerEntry {
  id            String       @id
  periodId      String       @map("period_id")
  transactionDate DateTime   @map("transaction_date") @db.Date
  month         Int
  type          NutLedgerType
  bucket        String
  detail        String
  income        BigInt       @default(0)
  expense       BigInt       @default(0)
  balance       BigInt       @default(0)
  amount        BigInt       @default(0)
  claimant      String?
  note          String?
  source        String
  taxClass      NutTaxClass  @map("tax_class")
  // 팀지원비·기술지원비·운영팀 지원비로 나간 돈이면 어느 팀 돈인지. 팀별 지원비 화면은 이 값으로 모은다.
  teamId        String?      @map("team_id")
  // 기록한 시각. 같은 날 거래는 이 순서로 보인다.
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([periodId, transactionDate, createdAt])
  @@index([teamId])
  @@index([bucket])
  @@map("ledger_entries")
  @@schema("nut")
}

model NutAccountingDetail {
  id        String                 @id
  periodId  String                 @map("period_id")
  scope     NutAccountingScope
  owner     String
  category  NutAccountingCategory
  date      DateTime               @db.Date
  detail    String
  amount    BigInt
  balance   BigInt
  claimant  String?

  @@index([periodId, scope, owner, date])
  @@map("accounting_details")
  @@schema("nut")
}

model NutAccountingSummary {
  id             String             @id
  periodId       String             @map("period_id")
  scope          NutAccountingScope
  // 프로젝트 팀의 학기 구분: summer(방학)·regular(정규). 운영팀은 "".
  term           String             @default("")
  name           String
  supportBudget  BigInt             @map("support_budget")
  supportSpent   BigInt             @map("support_spent")
  technicalBudget BigInt            @map("technical_budget")
  technicalSpent BigInt             @map("technical_spent")
  entryCount     Int                @map("entry_count")
  note           String?

  @@unique([periodId, scope, term, name])
  @@map("accounting_summaries")
  @@schema("nut")
}

// 청구서. 회원이 NUT 화면이나 Slack으로 올리고, 총무가 승인·반려·지급한다.
// 지급하면 같은 트랜잭션에서 회계(ledger_entries)에 지출로 기록하고 ledgerEntryId로 잇는다.
model NutClaim {
  id                 String         @id
  periodId           String         @map("period_id")
  date               DateTime       @db.Date
  detail             String
  amount             BigInt
  claimant           String
  bucket             String
  status             NutClaimStatus
  source             String
  // true = 개인이 먼저 내고 돌려받음(영수증 필요), false = 법인카드 결제.
  prepaid            Boolean        @default(false)
  slackLink          String?        @map("slack_link")
  memberId           String?        @map("member_id")
  bankAccount        String?        @map("bank_account")
  note               String?
  rejectReason       String?        @map("reject_reason")
  reviewedByMemberId String?        @map("reviewed_by_member_id")
  reviewedAt         DateTime?      @map("reviewed_at")
  paidAt             DateTime?      @map("paid_at")
  ledgerEntryId      String?        @unique @map("ledger_entry_id")
  createdAt          DateTime       @default(now()) @map("created_at")

  @@index([periodId, status, date])
  @@map("claims")
  @@schema("nut")
}

// 세금 탭의 입력값(매입세액, 원천징수 대상 지급액, 고유목적사업준비금 비율 등).
// key 예: "vat:2026-1:input-tax", "fy:2026:business-paid". 계산은 코드(taxRepository)에서 한다.
model NutTaxInput {
  key       String   @id
  value     Float
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tax_inputs")
  @@schema("nut")
}

// 회원 환급 계좌(예전 내부운영 시트 '학회원 정보'). 청구서가 Slack으로 들어올 때 청구인의
// Slack 이메일(없으면 이름)로 찾아 계좌를 채운다. 보기·수정 모두 총무·admin만.
// 전화번호·생일은 쓰지 않으므로 저장하지 않는다.
model NutRefundAccount {
  id          String   @id
  name        String
  cohort      String?
  email       String?  @unique
  bankAccount String   @map("bank_account")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("refund_accounts")
  @@schema("nut")
}

// 출석체크: Slack '출석핑' 워크플로(출석 기록·지각 시간)와 화면 입력으로 쌓인다.
// 벌점·벌금은 저장하지 않고 type·excuse·minutes_late로 조회 때 계산한다(src/nut/lib/attendance.ts).
model NutAttendanceRecord {
  id          String   @id
  date        DateTime @db.Date
  name        String
  email       String?
  project     String?
  type        String   // late | absent | quest
  excuse      String   // excused | partial | unexcused
  minutesLate Int?     @map("minutes_late")
  tier        String?  // 지각 구간 직접 지정(규칙 id). 없으면 지각 분 ÷ 세션 길이로 자동
  note        String?
  source      String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("attendance_records")
  @@schema("nut")
}

// 출석체크 벌점·벌금 기준(반기별). key = '<규칙 id>.points'·'<규칙 id>.fine'·'session-minutes'.
// 행이 없으면 코드의 기본값(벌점벌금 시트의 값)을 쓴다.
// 출석체크 벌점 초기화(분기마다). cleared_through까지의 기록은 지우지 않고 합계에서만 뺀다.
// 가장 최근 행이 기준이고, 그 행을 지우면 되돌린 것이 된다.
model NutAttendanceReset {
  id             String   @id
  clearedThrough DateTime @map("cleared_through") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("attendance_resets")
  @@schema("nut")
}

model NutAttendanceSetting {
  periodId String @map("period_id")
  key      String
  value    Int

  @@id([periodId, key])
  @@map("attendance_settings")
  @@schema("nut")
}

model NutTaxSummary {
  id                   String @id
  periodId             String @map("period_id")
  taxableGains         BigInt @map("taxable_gains")
  nonTaxableGains      BigInt @map("non_taxable_gains")
  deductibleExpenses   BigInt @map("deductible_expenses")
  nonDeductibleExpenses BigInt @map("non_deductible_expenses")
  freelanceContractCost BigInt @map("freelance_contract_cost")
  corporateTax         BigInt @map("corporate_tax")
  withholdingTax       BigInt @map("withholding_tax")
  vat                  BigInt
  totalTax             BigInt @map("total_tax")

  @@unique([periodId])
  @@map("tax_summaries")
  @@schema("nut")
}

// ---------- hr (그핵드인) — 소유자: hr ----------
//
// 설계 스펙 원본은 DB_SCHEMA_HR.md(repo 바깥, 기획 문서). hr이 실제로 소유하는
// 테이블은 이 2개뿐이다 — 나머지(core.members 등)는 portal 소유를 읽기만 한다
// (docs/db/conventions.md §3, §4).

enum EditRequestStatus {
  pending
  approved
  rejected
  @@schema("hr")
}

// 알럼나이가 제출한 프로필 수정은 Notion에 바로 반영되지 않고 여기 "승인 대기"로
// 쌓인다. 관리자가 승인해야 실제 write-back이 일어난다(DB_SCHEMA_HR.md §1).
model EditRequest {
  id                 String            @id @default(cuid())
  notionPageId       String            @map("notion_page_id")
  requesterMemberId  String            @map("requester_member_id")
  requester          Member            @relation("EditRequestRequester", fields: [requesterMemberId], references: [id])
  diff               Json
  status             EditRequestStatus @default(pending)
  submittedAt        DateTime          @default(now()) @map("submitted_at")
  reviewedByMemberId String?           @map("reviewed_by_member_id")
  reviewedBy         Member?           @relation("EditRequestReviewer", fields: [reviewedByMemberId], references: [id])
  reviewedAt         DateTime?         @map("reviewed_at")
  reviewNote         String?           @map("review_note")

  // 같은 notionPageId로 pending 행이 동시에 2개 이상 생기면 안 된다(재수정은
  // 새 행이 아니라 기존 pending 행을 덮어쓰는 방식, ARCHITECTURE.md §12.3.1) —
  // Prisma 문법으로 표현할 수 없어서(부분 유니크 인덱스) 마이그레이션에 직접
  // 쓴다(members_ops_role_singleton_key와 같은 패턴). 여기 없다고 없는 게
  // 아니라 migrations/에서 찾아야 한다.
  @@index([status, submittedAt(sort: Desc)])
  @@map("edit_requests")
  @@schema("hr")
}

// Notion People DB 조회 결과의 TTL 캐시. key는 "list"(디렉토리 목록 경량 요약) 또는
// 개별 notionPageId(그 사람의 전체 프로필) 둘 중 하나뿐이다 — 필터 조합별로 row를
// 늘리지 않는다(DB_SCHEMA_HR.md §2, §2.1). core.people_directory(가입 시 본인확인용
// 얕은 사본, portal 소유)와는 완전히 다른 테이블이니 혼동하지 않는다.
model PeopleCache {
  key       String   @id
  data      Json
  fetchedAt DateTime @map("fetched_at")

  @@map("people_cache")
  @@schema("hr")
}
