  @@schema("dh")
}

enum ValidationStatus {
  not_checked
  valid_format
  invalid
  @@schema("dh")
}

enum ReachabilityStatus {
  unknown
  confirmed
  unavailable
  @@schema("dh")
}

enum LinkedinMethod {
  connection_request
