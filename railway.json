{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w apps/backend"
  },
  "deploy": {
    "startCommand": "npm run start -w apps/backend",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
