# Supabase Auth — apps/portal-backend/.env.example과 같은 프로젝트 값을 쓴다.
# 로그인 자체는 portal-frontend가 전담하고, 이 앱은 같은 프로젝트의 세션을
# 읽기만 한다(ARCHITECTURE.md §3.1).
VITE_SUPABASE_URL="https://[project-ref].supabase.co"
VITE_SUPABASE_ANON_KEY=""

# hr 백엔드(apps/hr-backend/) 주소. 로컬 개발 기본값은 아래와 같음.
VITE_API_BASE_URL="http://localhost:3002"

# 로컬 개발 전용: side pane에서 관리자/대협봇으로 이동하거나, 세션이 없을 때
# 로그인 화면으로 보낼 때 실제로 이동할 절대 URL. production에서는 비워둔다 —
# gateway가 같은 origin 아래로 rewrite해주므로 상대 경로("/admin", "/login")
# 만으로 충분하다. portal-frontend/.env.example의 VITE_DH_URL/VITE_HR_URL과
# 같은 이유.
# VITE_PORTAL_URL="http://localhost:5174"
# VITE_DH_URL="http://localhost:5173"
