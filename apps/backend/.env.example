# === Database (Supabase Postgres, via Prisma) ===
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# 두 값 다 대시보드의 "Direct connection" 탭이 아니라 pooler 호스트
# (aws-0-[region].pooler.supabase.com)를 쓴다. 진짜 "Direct connection"
# (db.[project-ref].supabase.co)은 IPv6 전용이라 IPv4만 되는 일반 네트워크
# (가정집·회사 와이파이 등)에서는 "Can't reach database server"로 그냥 막힌다.
#
# Transaction pooler (포트 6543) -- 앱 런타임 쿼리용
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (포트 6543이 아니라 5432, 같은 pooler 호스트) -- `prisma migrate`용.
# 대시보드에서 "Session pooler" 탭을 선택해서 복사한다.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# === Supabase Auth ===
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never expose to the frontend or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=""

# === Gemini ===
# Server-only Gemini API key. Never expose this in the frontend.
GEMINI_API_KEY=""

# GH Bot member tokens: a base64url-encoded 32-byte encryption key for
# administrator re-copy, plus the secret shared only with the ghbot server.
GHBOT_TOKEN_ENCRYPTION_KEY=""
GHBOT_AUTH_SHARED_SECRET=""

# === Listup AI ===
# Server-only model used for Google Search grounding and structured extraction.
LISTUP_GEMINI_MODEL="gemini-3.5-flash-lite"
# Start the StartupRecipe collection and research schedules only after their DB migrations are applied.
HUMAN_REVIEW_PIPELINE_ENABLED="false"
# Local-only agent timing/token report (printed by the Inngest worker; never persisted).
LISTUP_LOCAL_OBSERVABILITY="true"
# Set these from your Gemini contract/pricing page to calculate USD estimates.
LISTUP_INPUT_COST_PER_MILLION_USD=""
LISTUP_OUTPUT_COST_PER_MILLION_USD=""
LISTUP_WEB_SEARCH_CALL_COST_USD=""

# === Notion ===
# hr 런타임(People DB)과 dh의 past-projects:import 스크립트(프로젝트 DB)가 같이 쓴다.
# Notion internal integration token. The project database must be shared with this integration.
NOTION_API_KEY="ntn_..."
# Database ID for the Notion project database (not a page URL).
NOTION_PROJECTS_DATABASE_ID=""
# Property names in the project database. Change these if the Notion columns are renamed.
NOTION_PROJECT_COMPANY_PROPERTY="기업"
NOTION_PROJECT_TITLE_PROPERTY="한줄설명"
NOTION_PROJECT_QUARTER_PROPERTY="분기"
NOTION_PROJECT_TECHNOLOGY_PROPERTY="기술분류"
NOTION_PROJECT_INDUSTRY_PROPERTY="산업 분류"
# 노션에만 있고 dh.company에 없는 기업을 기본 정보로 자동 생성할지 여부
NOTION_PROJECT_CREATE_MISSING_COMPANIES="true"

# === Inngest ===
# 로컬 개발(inngest-cli dev)에서는 비워둬도 됨. 배포 시 Inngest 대시보드에서 발급.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# === Notion People DB ===
# hr 디렉토리·프로필 승인(서버 런타임)과 portal의 people:import 스크립트가 쓴다.
# People DB를 위 NOTION_API_KEY integration에 공유해야 한다.
NOTION_PEOPLE_DATABASE_ID=""
# 컬럼명이 기본값(기수/Name/이메일)과 다르면 지정
# NOTION_COHORT_PROPERTY="기수"
# NOTION_NAME_PROPERTY="Name"
# NOTION_EMAIL_PROPERTY="이메일"

# === Resend (portal: 가입 OTP 메일 발송) ===
RESEND_API_KEY="re_..."
# 도메인 인증 전엔 비워두면 resend.dev 테스트 주소로 발송됨.
# RESEND_FROM_ADDRESS="onboarding@resend.dev"

# === CORS ===
# 기본값(로컬 5173 + 운영 admin.ghsnu.com)으로 충분하면 비워둬도 됨.
# 배포 프리뷰 URL 등을 추가하려면 콤마로 구분해서 지정(지정하면 기본값을 대체한다).
# ALLOWED_ORIGINS="http://localhost:5173,https://admin.ghsnu.com"

# =
# Slack 청구서 자동화 → POST /api/v1/internal/nut/claims 의 x-nut-webhook-secret 헤더 값.
# 비워두면 그 엔드포인트는 모든 요청을 거부한다.
NUT_CLAIMS_WEBHOOK_SECRET=
