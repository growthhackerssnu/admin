{
  "display_information": {
    "name": "GH NUT",
    "description": "청구서·출석핑 워크플로 답변을 NUT(admin.ghsnu.com/nut)에 등록합니다.",
    "background_color": "#01397c"
  },
  "features": {
    "bot_user": {
      "display_name": "GH NUT",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://admin-backend-ebyvikzkma-du.a.run.app/api/slack/events",
      "bot_events": [
        "function_executed"
      ]
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false,
    "function_runtime": "remote"
  },
  "functions": {
    "register_nut_claim": {
      "title": "NUT에 청구서 등록",
      "description": "양식 답변으로 NUT 청구서를 만듭니다. 총무가 NUT에서 승인·지급합니다.",
      "input_parameters": {
        "claimant": {
          "type": "slack#/types/user_id",
          "title": "청구인",
          "is_required": true
        },
        "date": {
          "type": "slack#/types/date",
          "title": "일시(쓴 날짜)",
          "is_required": true
        },
        "detail": {
          "type": "string",
          "title": "상세 내역",
          "is_required": true
        },
        "amount": {
          "type": "string",
          "title": "지출(원)",
          "description": "숫자 또는 '23,500원' 같은 텍스트",
          "is_required": true
        },
        "bank_account": {
          "type": "string",
          "title": "계좌번호",
          "is_required": false
        },
        "bucket": {
          "type": "string",
          "title": "예산 항목",
          "description": "비우면 총무가 지급 전에 정합니다",
          "is_required": false
        },
        "note": {
          "type": "string",
          "title": "메모",
          "is_required": false
        }
      },
      "output_parameters": {
        "claim_id": {
          "type": "string",
          "title": "NUT 청구서 id",
          "is_required": true
        }
      }
    },
    "record_roll_call": {
      "title": "NUT에 출석 기록",
      "description": "출석체크 양식의 네 명단을 NUT 출석체크에 기록합니다. 날짜는 실행한 날(한국 시간)입니다.",
      "input_parameters": {
        "project": {
          "type": "string",
          "title": "프로젝트명",
          "is_required": false
        },
        "excused_absent": {
          "type": "array",
          "items": {
            "type": "slack#/types/user_id"
          },
          "title": "사유결석인원",
          "is_required": false
        },
        "excused_late": {
          "type": "array",
          "items": {
            "type": "slack#/types/user_id"
          },
          "title": "사유지각인원",
          "is_required": false
        },
        "unexcused_absent": {
          "type": "array",
          "items": {
            "type": "slack#/types/user_id"
          },
          "title": "무단결석인원",
          "is_required": false
        },
        "unexcused_late": {
          "type": "array",
          "items": {
            "type": "slack#/types/user_id"
          },
          "title": "무단지각인원",
          "is_required": false
        }
      },
      "output_parameters": {
        "recorded": {
          "type": "number",
          "title": "기록한 사람 수",
          "is_required": true
        }
      }
    },
    "record_late_arrival": {
      "title": "NUT에 지각 시간 기록",
      "description": "'지각했어용'을 누른 사람의 오늘 출석 기록에 늦은 시간(분)을 채웁니다.",
      "input_parameters": {
        "user": {
          "type": "slack#/types/user_id",
          "title": "늦은 사람",
          "is_required": true
        },
        "minutes": {
          "type": "string",
          "title": "늦은 시간(분)",
          "description": "숫자 또는 '15분' 같은 텍스트",
          "is_required": true
        }
      },
      "output_parameters": {
        "record_id": {
          "type": "string",
          "title": "출석 기록 id",
          "is_required": true
        }
      }
    }
  }
}
