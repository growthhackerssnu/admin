{
  "display_information": {
    "name": "GH NUT",
    "description": "청구서 워크플로 답변을 NUT(admin.ghsnu.com/nut)에 등록합니다.",
    "background_color": "#01397c"
  },
  "features": {
    "bot_user": {
      "display_name": "GH NUT",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://admin-backend-ebyvikzkma-du.a.run.app/api/slack/events",
      "bot_events": [
        "function_executed"
      ]
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false,
    "function_runtime": "remote"
  },
  "functions": {
    "register_nut_claim": {
      "title": "NUT에 청구서 등록",
      "description": "양식 답변으로 NUT 청구서를 만듭니다. 총무가 NUT에서 승인·지급합니다.",
      "input_parameters": {
        "claimant": {
          "type": "slack#/types/user_id",
          "title": "청구인",
          "is_required": true
        },
        "date": {
          "type": "slack#/types/date",
          "title": "일시(쓴 날짜)",
          "is_required": true
        },
        "detail": {
          "type": "string",
          "title": "상세 내역",
          "is_required": true
        },
        "amount": {
          "type": "string",
          "title": "지출(원)",
          "description": "숫자 또는 '23,500원' 같은 텍스트",
          "is_required": true
        },
        "prepaid": {
          "type": "string",
          "title": "선결제 후지급",
          "description": "예/아니오. 비우면 예",
          "is_required": false
        },
        "bank_account": {
          "type": "string",
          "title": "계좌번호",
          "is_required": false
        },
        "bucket": {
          "type": "string",
          "title": "예산 항목",
          "description": "비우면 총무가 지급 전에 정합니다",
          "is_required": false
        },
        "note": {
          "type": "string",
          "title": "메모",
          "is_required": false
        }
      },
      "output_parameters": {
        "claim_id": {
          "type": "string",
          "title": "NUT 청구서 id",
          "is_required": true
        }
      }
    }
  }
}