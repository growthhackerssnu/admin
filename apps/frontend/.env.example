# 백엔드(apps/backend) 주소. 운영은 https://admin-api.ghsnu.com
VITE_API_BASE_URL="http://localhost:3000"

# 운영 백엔드를 로컬에서 확인할 때만 사용. VITE_API_BASE_URL을 현재 Vite origin으로 설정한다.
# VITE_API_BASE_URL="http://127.0.0.1:5184"
# DEV_API_PROXY_TARGET="https://admin-api.ghsnu.com"

# Supabase Dashboard -> Project Settings -> API (Project URL, anon public key).
# 공개 키만 넣는다. service_role 키·DB 접속 정보는 절대 넣지 않는다.
VITE_SUPABASE_URL="https://[project-ref].supabase.co"
VITE_SUPABASE_ANON_KEY=""
