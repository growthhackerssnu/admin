{
  "name": "dhbot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts",
    "tokens": "node scripts/generate-design-tokens.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "prebuild": "npm run tokens",
    "predev": "npm run tokens"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@dhbot/ui-shell": "*",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@supabase/supabase-js": "2.117.0",
    "antd": "5.27.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.6.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "^4.14.1",
    "react-router-dom": "^6.28.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "nanoid": "3.3.11"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
