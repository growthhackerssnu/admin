# === Database (Supabase Postgres, via Prisma) ===
# apps/dh-backend와 같은 프로젝트/같은 값. 이 앱은 마이그레이션을 만들지
# 않는다 — 물리 스키마의 단일 소스는 apps/dh-backend/prisma다.
#
# Transaction pooler (포트 6543) -- 앱 런타임 쿼리용
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (포트 5432, 같은 pooler 호스트) -- prisma generate 시 스키마 조회용.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# === Supabase Auth ===
# apps/dh-backend/.env.example과 같은 프로젝트 값.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# === Resend (가입 OTP 메일 발송) ===
# apps/dh-backend/.env.example과 같은 계정/키를 쓰면 된다.
RESEND_API_KEY="re_..."
# 도메인 인증 전엔 비워두면 resend.dev 테스트 주소로 발송됨.
# RESEND_FROM_ADDRESS="onboarding@resend.dev"

# === CORS ===
# 기본값(로컬 5174 + 운영 admin.ghsnu.com)으로 충분하면 비워둬도 됨.
# ALLOWED_ORIGINS="http://localhost:5174,https://admin.ghsnu.com"
