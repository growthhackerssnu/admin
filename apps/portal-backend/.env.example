# === Database (Supabase Postgres, via Prisma) ===
# apps/dh-backend와 같은 프로젝트/같은 값. 이 앱은 마이그레이션을 만들지
# 않는다 — 물리 스키마의 단일 소스는 packages/db다(docs/db/conventions.md §7).
#
# Transaction pooler (포트 6543) -- 앱 런타임 쿼리용
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (포트 5432, 같은 pooler 호스트) -- prisma generate 시 스키마 조회용.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# === Supabase Auth ===
# apps/dh-backend/.env.example과 같은 프로젝트 값.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# === Notion (People DB 동기화 — npm run people:import에만 필요) ===
# notion.so/my-integrations 에서 internal integration 생성 후 토큰 발급하고,
# People DB를 Share 메뉴에서 그 integration에 공유해야 한다.
# 동기화 결과가 들어가는 core.people_directory는 "가입 신청자가 진짜 명단에
# 있는 사람인지"만 확인하는 용도다. acting/alumni role은 여기서 정하지 않는다
# (가입 직후엔 alumni 고정, admin이 나중에 승격).
NOTION_API_KEY=""
NOTION_PEOPLE_DATABASE_ID=""
# 컬럼명이 기본값(기수/Name/이메일)과 다르면 지정
# NOTION_COHORT_PROPERTY="기수"
# NOTION_NAME_PROPERTY="Name"
# NOTION_EMAIL_PROPERTY="이메일"

# === Resend (가입 OTP 메일 발송) ===
# apps/dh-backend/.env.example과 같은 계정/키를 쓰면 된다.
RESEND_API_KEY="re_..."
# 도메인 인증 전엔 비워두면 resend.dev 테스트 주소로 발송됨.
# RESEND_FROM_ADDRESS="onboarding@resend.dev"

# === CORS ===
# 기본값(로컬 5174 + 운영 admin.ghsnu.com)으로 충분하면 비워둬도 됨.
# ALLOWED_ORIGINS="http://localhost:5174,https://admin.ghsnu.com"
