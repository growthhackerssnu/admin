# Supabase Auth — apps/portal-backend/.env.example과 같은 프로젝트 값을 쓴다.
VITE_SUPABASE_URL="https://[project-ref].supabase.co"
VITE_SUPABASE_ANON_KEY=""

# 포털 백엔드(apps/portal-backend/) 주소. 로컬 개발 기본값은 아래와 같음.
VITE_API_BASE_URL="http://localhost:3001"

# 로컬 개발 전용: 로그인 직후 role 기반 리다이렉트("/dh", "/hr")가 실제로
# 이동할 앱의 절대 URL. production에서는 비워둔다 — gateway가 같은 origin
# 아래로 rewrite해주므로 상대 경로("/dh", "/hr")만으로 충분하다.
# VITE_DH_URL="http://localhost:5173"
# VITE_HR_URL="http://localhost:5175"
