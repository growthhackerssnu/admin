# 대협봇 백엔드(apps/dh-backend/) 주소. 로컬 개발 기본값은 아래와 같음.
# /listup.html 실데이터 화면에서 사용하는 주소.
# /api/v1 접미사는 있어도 없어도 된다. 토큰이나 비밀 키는 여기에 넣지 않는다.
VITE_API_BASE_URL="http://localhost:3000"
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
# 레거시 anon 공개 키도 VITE_SUPABASE_ANON_KEY로 사용할 수 있다.
