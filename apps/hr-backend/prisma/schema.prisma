// apps/hr-backend가 쓰는 테이블 목록 — 생성 전용 사본이다.
//
// 물리 스키마의 원본은 packages/db/schema.prisma이고, 마이그레이션도 거기서만
// 만든다. 이 파일은 prisma generate로 이 앱의 타입을 뽑기 위한 것이므로, 여기서
// prisma migrate를 실행하면 안 된다 — 이 스키마는 DB 전체(core 일부와 dh)를
// 모르기 때문에 Prisma가 모르는 테이블을 삭제 대상으로 판단한다.
// 규칙: docs/db/conventions.md §7
//
// ───────────────────────────────────────────────────────────────────────────
// hr 테이블을 추가하려면:
//   1. packages/db/schema.prisma의 datasource.schemas에 "hr"을 추가한다
//   2. 거기에 모델을 만들고 각각 @@schema("hr")을 붙인다
//   3. cd packages/db && npm run db:migrate
//   4. 그 모델을 이 파일에도 복사하고 아래 schemas에 "hr"을 추가한다
//   5. npm run db:generate
//   6. docs/db/conventions.md §4의 데이터 딕셔너리에 한 줄씩 추가한다
//
// Postgres에는 hr 스키마가 비어 있는 상태로 이미 만들어져 있다.
// ───────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  // npm workspaces가 @prisma/client를 루트 node_modules로 hoist하는데, 이
  // 저장소엔 스키마가 다른 Prisma Client가 여럿 있다 — 같은 위치로 generate하면
  // 나중에 실행한 쪽이 다른 쪽 타입을 덮어쓴다. 앱마다 생성 위치를 분리한다.
  output = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["core", "hr"]
}

// ---------- core (소유자: portal — 읽기만 한다) ----------
//
// core.members는 세 앱이 공유하는 회원 화이트리스트다. 이 앱은 요청마다
// "이 사람이 명단에 있나"를 확인하려고 읽기만 한다. role이나 active를 바꾸는
// 코드는 갖지 않는다 — 그건 portal 전용이다 (conventions.md §5.1).
//
// hr 업무용 회원 정보를 저장하고 싶어도 core.members에 컬럼을 추가하지 않는다.
// hr 스키마에 member_id를 참조하는 별도 테이블을 만든다 (§5.3).

enum Role {
  admin
  acting
  alumni

  @@schema("core")
}

// 운영팀 직책 — acting에게만 붙는다. 회장·부회장·총무와 각 팀장은 한 명씩이고
// 팀원은 여러 명이다(유일성은 packages/db 마이그레이션의 부분 유니크 인덱스).
enum OpsRole {
  president       // 회장
  vice_president  // 부회장
  treasurer       // 총무
  external_lead   // 대외협력 팀장
  external_member // 대외협력 팀원
  hr_lead         // HR 팀장
  hr_member       // HR 팀원
  pr_lead         // PR 팀장
  pr_member       // PR 팀원
  edu_lead        // 에듀 팀장
  @@schema("core")
}

model Member {
  id             String    @id @default(cuid())
  supabaseUserId String?   @unique @map("supabase_user_id")
  email          String    @unique
  displayName    String    @map("display_name")
  role           Role      @default(acting)
  // 운영팀 직책. acting에게만 값이 있고 alumni·admin은 NULL이다(OpsRole 주석 참고).
  opsRole        OpsRole?  @map("ops_role")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  lastLoginAt    DateTime? @map("last_login_at")

  // 이 사람이 가입할 때(기수+이름+OTP 인증) people_directory의 어느 항목을
  // "내 것"이라고 인증했는지를 가리킨다. GET /api/v1/me가 notionPageId를
  // 돌려줄 때 씀(ARCHITECTURE.md §12.2.1). 아래 주석에 적었듯 실제 저장되는
  // 컬럼은 반대편(PeopleDirectory.claimedByMemberId)에만 있다.
  claimedPersonEntry PeopleDirectory?

  // hr(그핵드인) — 프로필 수정 승인 큐. 본인이 제출한 요청과 자신이 검토한
  // 요청(admin)은 서로 다른 관계다. DB_SCHEMA_HR.md §1 참고.
  editRequestsSubmitted EditRequest[] @relation("EditRequestRequester")
  editRequestsReviewed  EditRequest[] @relation("EditRequestReviewer")

  @@map("members")
  @@schema("core")
}

// 노션 People DB에서 가져온 "신뢰 이메일" 원장의 읽기 전용 사본. 물리 스키마
// 원본은 packages/db/schema.prisma에 있고(전체 필드는 거기 참고), 이 앱은
// GET /api/v1/me에서 notionPageId 하나만 읽으면 되므로 그 용도에 필요한
// 필드만 그대로 옮겨 적었다(hr은 이 테이블에 쓰지 않는다 — docs/db/conventions.md §4).
//
// PeopleDirectory.signupRequests(SignupRequest[]) 관계는 일부러 안 옮겼다 —
// hr-backend는 SignupRequest 모델 자체를 몰라도 되고(portal 전용), Prisma는
// "이 스키마 파일 안에서" 관계가 완결되기만 하면 되므로 문제 없다.
model PeopleDirectory {
  id                String    @id @default(cuid())
  notionPageId      String    @unique @map("notion_page_id")
  claimedByMemberId String?   @unique @map("claimed_by_member_id")
  claimedBy         Member?   @relation(fields: [claimedByMemberId], references: [id])

  @@map("people_directory")
  @@schema("core")
}

// ---------- hr (그핵드인) — 소유자: hr ----------
//
// 설계 스펙 원본은 DB_SCHEMA_HR.md(repo 바깥, 기획 문서). 물리 스키마 원본은
// packages/db/schema.prisma — 여기는 그 트림된 사본이다.

enum EditRequestStatus {
  pending
  approved
  rejected
  @@schema("hr")
}

// 알럼나이가 제출한 프로필 수정은 Notion에 바로 반영되지 않고 여기 "승인 대기"로
// 쌓인다. 관리자가 승인해야 실제 write-back이 일어난다(DB_SCHEMA_HR.md §1).
model EditRequest {
  id                 String            @id @default(cuid())
  notionPageId       String            @map("notion_page_id")
  requesterMemberId  String            @map("requester_member_id")
  requester          Member            @relation("EditRequestRequester", fields: [requesterMemberId], references: [id])
  diff               Json
  status             EditRequestStatus @default(pending)
  submittedAt        DateTime          @default(now()) @map("submitted_at")
  reviewedByMemberId String?           @map("reviewed_by_member_id")
  reviewedBy         Member?           @relation("EditRequestReviewer", fields: [reviewedByMemberId], references: [id])
  reviewedAt         DateTime?         @map("reviewed_at")
  reviewNote         String?           @map("review_note")

  // 같은 notionPageId로 pending 행이 동시에 2개 이상 생기면 안 된다(재수정은
  // 새 행이 아니라 기존 pending 행을 덮어쓰는 방식, ARCHITECTURE.md §12.3.1) —
  // Prisma 문법으로 표현할 수 없어서(부분 유니크 인덱스) 마이그레이션에 직접
  // 쓴다(members_ops_role_singleton_key와 같은 패턴). 여기 없다고 없는 게
  // 아니라 packages/db/migrations/에서 찾아야 한다.
  @@index([status, submittedAt(sort: Desc)])
  @@map("edit_requests")
  @@schema("hr")
}

// Notion People DB 조회 결과의 TTL 캐시. key는 "list"(디렉토리 목록 경량 요약) 또는
// 개별 notionPageId(그 사람의 전체 프로필) 둘 중 하나뿐이다(DB_SCHEMA_HR.md §2, §2.1).
// core.people_directory(위 모델, 가입 시 본인확인용 얕은 사본)와는 완전히 다른
// 테이블이니 혼동하지 않는다.
model PeopleCache {
  key       String   @id
  data      Json
  fetchedAt DateTime @map("fetched_at")

  @@map("people_cache")
  @@schema("hr")
}
