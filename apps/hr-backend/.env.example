# === Database (Supabase Postgres, via Prisma) ===
# apps/dh-backend / apps/portal-backend와 같은 Supabase 프로젝트·같은 값이다.
# 이 앱은 마이그레이션을 만들지 않는다 — 물리 스키마의 단일 소스는 packages/db다
# (docs/db/conventions.md §7).
#
# 두 값 다 대시보드의 "Direct connection" 탭이 아니라 pooler 호스트
# (aws-0-[region].pooler.supabase.com)를 쓴다. 진짜 Direct connection은 IPv6
# 전용이라 IPv4만 되는 일반 네트워크에서는 그냥 막힌다.

# Transaction pooler (포트 6543) -- 앱 런타임 쿼리용
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (포트 5432, 같은 pooler 호스트) -- prisma generate 시 스키마 조회용
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# === Supabase Auth ===
# apps/portal-backend와 같은 프로젝트 값. 로그인 자체는 포털이 처리하고,
# 이 앱은 받은 토큰을 검증하기만 한다.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# === CORS ===
# 기본값(로컬 5175 + 운영 admin.ghsnu.com)으로 충분하면 비워둬도 된다.
# ALLOWED_ORIGINS="http://localhost:5175,https://admin.ghsnu.com"
