# Same Supabase project as portal/dh/hr. NUT currently reads core.members
# for authentication and keeps its first item repository in memory.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Default: http://localhost:5176,https://admin.ghsnu.com
ALLOWED_ORIGINS="http://localhost:5176,https://admin.ghsnu.com"
