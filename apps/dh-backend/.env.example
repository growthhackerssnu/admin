# === Database (Supabase Postgres, via Prisma) ===
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# 두 값 다 대시보드의 "Direct connection" 탭이 아니라 pooler 호스트
# (aws-0-[region].pooler.supabase.com)를 쓴다. 진짜 "Direct connection"
# (db.[project-ref].supabase.co)은 IPv6 전용이라 IPv4만 되는 일반 네트워크
# (가정집·회사 와이파이 등)에서는 "Can't reach database server"로 그냥 막힌다.
#
# Transaction pooler (포트 6543) -- 앱 런타임 쿼리용
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (포트 6543이 아니라 5432, 같은 pooler 호스트) -- `prisma migrate`용.
# 대시보드에서 "Session pooler" 탭을 선택해서 복사한다.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# === Supabase Auth ===
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never expose to the frontend or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=""

# === OpenAI ===
OPENAI_API_KEY="sk-..."

# === Inngest ===
# 로컬 개발(inngest-cli dev)에서는 비워둬도 됨. 배포 시 Inngest 대시보드에서 발급.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# === CORS ===
# 기본값(로컬 5173 + 운영 admin.ghsnu.com)으로 충분하면 비워둬도 됨.
# 배포 프리뷰 URL 등을 추가하려면 콤마로 구분해서 지정.
# ALLOWED_ORIGINS="http://localhost:5173,https://admin.ghsnu.com"
