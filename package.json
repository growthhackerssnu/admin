{
  "name": "dhbot",
  "version": "0.1.0",
  "private": true,
  "description": "Growth Hackers 산학협력 대외협력 봇 — Slack 기반 기업/담당자 리서치 및 아웃리치 초안 작성 보조 도구",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "prisma:generate": "dotenv -e .env.local -- prisma generate",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "dev:seed": "dotenv -e .env.local -- tsx src/dev/runSeedCli.ts",
    "seed:sources": "dotenv -e .env.local -- tsx src/dev/seedSourceFeeds.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@notionhq/client": "^5.26.0",
    "@prisma/client": "^5.22.0",
    "@slack/bolt": "^4.1.0",
    "@slack/web-api": "^7.7.0",
    "@vercel/slack-bolt": "^1.6.5",
    "googleapis": "^144.0.0",
    "inngest": "^3.28.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
